---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Estadísticas - VetPets">
  <div class="min-h-screen" style="background: #f5f0eb;">
    <Sidebar />

    <!-- Main content wrapper -->
    <div class="lg:ml-64 min-h-screen transition-[margin] duration-200" data-main-content>
      <!-- Top header -->
      <header class="sticky top-0 z-30 bg-white/80 backdrop-blur border-b" style="border-color: #ebe5dd;">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <button id="hamburgerBtn" class="lg:hidden p-2 rounded-lg hover:bg-black/5 transition-colors" style="color: #3d2e22;">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
            <div>
              <h1 class="text-xl font-bold" style="color: #3d2e22;">Estadísticas</h1>
              <p class="text-xs hidden sm:block" style="color: #9a8b7c;">Vista general del rendimiento</p>
            </div>
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
        <!-- Loading State -->
        <div id="loadingState" class="flex items-center justify-center py-20">
          <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-emerald-400"></div>
        </div>

        <!-- Stats Content -->
        <div id="statsContent" class="hidden">
          <!-- Summary Cards -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-xl p-5" style="border: 1px solid #ebe5dd;">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm" style="color: #9a8b7c;">Total Clientes</p>
                  <p id="totalClientes" class="text-3xl font-bold mt-1" style="color: #3d2e22;">0</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center">
                  <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
              </div>
            </div>
            <div class="bg-white rounded-xl p-5" style="border: 1px solid #ebe5dd;">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm" style="color: #9a8b7c;">Total Mascotas</p>
                  <p id="totalMascotas" class="text-3xl font-bold mt-1" style="color: #3d2e22;">0</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-amber-500/20 flex items-center justify-center">
                  <span class="text-2xl">&#x1F43E;</span>
                </div>
              </div>
            </div>
            <div class="bg-white rounded-xl p-5" style="border: 1px solid #ebe5dd;">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm" style="color: #9a8b7c;">Total Citas</p>
                  <p id="totalCitas" class="text-3xl font-bold mt-1" style="color: #3d2e22;">0</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-emerald-500/20 flex items-center justify-center">
                  <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              </div>
            </div>
            <div class="bg-white rounded-xl p-5" style="border: 1px solid #ebe5dd;">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm" style="color: #9a8b7c;">Promedio Mascotas/Cliente</p>
                  <p id="promedioMascotas" class="text-3xl font-bold mt-1" style="color: #3d2e22;">0</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Charts Row -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Species Distribution -->
            <div class="bg-white rounded-2xl p-6" style="border: 1px solid #ebe5dd;">
              <h3 class="text-lg font-semibold mb-4" style="color: #3d2e22;">Distribución por Especie</h3>
              <div class="relative h-64">
                <canvas id="speciesChart"></canvas>
              </div>
            </div>

            <!-- Citas por Estado -->
            <div class="bg-white rounded-2xl p-6" style="border: 1px solid #ebe5dd;">
              <h3 class="text-lg font-semibold mb-4" style="color: #3d2e22;">Citas por Estado</h3>
              <div class="relative h-64">
                <canvas id="citasEstadoChart"></canvas>
              </div>
            </div>
          </div>

          <!-- Registrations per Month -->
          <div class="bg-white rounded-2xl p-6 mb-8" style="border: 1px solid #ebe5dd;">
            <h3 class="text-lg font-semibold mb-4" style="color: #3d2e22;">Clientes Registrados por Mes</h3>
            <div class="relative h-72">
              <canvas id="clientesChart"></canvas>
            </div>
          </div>

          <!-- Recent Activity -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Recent Clients -->
            <div class="bg-white rounded-2xl p-6" style="border: 1px solid #ebe5dd;">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold" style="color: #3d2e22;">Últimos Clientes</h3>
                <a href="/clientes" class="text-sm" style="color: #0d9488;">Ver todos &#x2192;</a>
              </div>
              <div id="recentClients" class="space-y-3">
                <p class="text-sm text-center py-4" style="color: #9a8b7c;">Cargando...</p>
              </div>
            </div>

            <!-- Recent Pets -->
            <div class="bg-white rounded-2xl p-6" style="border: 1px solid #ebe5dd;">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold" style="color: #3d2e22;">Últimas Mascotas</h3>
                <a href="/mascotas" class="text-sm" style="color: #0d9488;">Ver todas &#x2192;</a>
              </div>
              <div id="recentPets" class="space-y-3">
                <p class="text-sm text-center py-4" style="color: #9a8b7c;">Cargando...</p>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<style>
  :global(body) { background: #f5f0eb !important; }
</style>

<script>
  import { Chart, registerables } from 'chart.js';
  import type { Cliente } from '../domain/models/cliente';
  import type { Mascota } from '../domain/models/mascota';
  import type { CitaConDetalles } from '../domain/models/cita';
  import { getVetName, isAuthenticated, logout } from '../infrastructure/api/authService';
  import { listarClientes } from '../infrastructure/api/clienteService';
  import { listarMascotas } from '../infrastructure/api/mascotaService';
  import { listarCitas } from '../infrastructure/api/citaService';
  import {
    SPECIES_EMOJIS as speciesEmojis,
    computeEstadisticasSummary,
    computeSpeciesDistribution,
    computeCitasByEstado,
    computeMonthlyClientRegistrations,
    formatShortDate as formatDate,
    getRecentClientes,
    getRecentMascotas,
  } from '../application/use_cases/estadisticaUseCases';

  Chart.register(...registerables);

  // Check auth
  if (!isAuthenticated()) {
    window.location.href = '/';
  }

  // Sidebar elements
  const sidebar = document.getElementById('sidebar') as HTMLElement | null;
  const sidebarOverlay = document.getElementById('sidebarOverlay') as HTMLElement | null;
  const hamburgerBtn = document.getElementById('hamburgerBtn') as HTMLButtonElement | null;
  const sidebarVetName = document.getElementById('sidebarVetName') as HTMLParagraphElement | null;
  const userAvatarEl = document.getElementById('userAvatar') as HTMLDivElement | null;
  const sidebarLogoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement | null;

  // Content elements
  const loadingState = document.getElementById('loadingState') as HTMLDivElement | null;
  const statsContent = document.getElementById('statsContent') as HTMLDivElement | null;

  // Summary elements
  const totalClientesEl = document.getElementById('totalClientes') as HTMLParagraphElement | null;
  const totalMascotasEl = document.getElementById('totalMascotas') as HTMLParagraphElement | null;
  const totalCitasEl = document.getElementById('totalCitas') as HTMLParagraphElement | null;
  const promedioMascotasEl = document.getElementById('promedioMascotas') as HTMLParagraphElement | null;

  // Recent lists
  const recentClientsEl = document.getElementById('recentClients') as HTMLDivElement | null;
  const recentPetsEl = document.getElementById('recentPets') as HTMLDivElement | null;

  // Sidebar toggle
  hamburgerBtn?.addEventListener('click', () => {
    sidebar?.classList.remove('-translate-x-full');
    sidebarOverlay?.classList.remove('hidden');
  });
  sidebarOverlay?.addEventListener('click', () => {
    sidebar?.classList.add('-translate-x-full');
    sidebarOverlay?.classList.add('hidden');
  });

  // Set vet name
  const vetName = getVetName() || 'Veterinaria';
  if (sidebarVetName) sidebarVetName.textContent = vetName;
  if (userAvatarEl) userAvatarEl.textContent = vetName.charAt(0).toUpperCase();
  const vetNameEl = document.getElementById('vetName') as HTMLElement | null;
  if (vetNameEl) vetNameEl.textContent = vetName;

  // Logout
  sidebarLogoutBtn?.addEventListener('click', () => {
    logout();
    window.location.href = '/';
  });

  // Load data
  async function loadStats() {
    try {
      const [clientes, mascotas, citas] = await Promise.all([
        listarClientes(),
        listarMascotas(),
        listarCitas()
      ]);

      // Update summary via Use Case
      const summary = computeEstadisticasSummary(clientes, mascotas, citas);
      if (totalClientesEl) totalClientesEl.textContent = summary.totalClientes.toString();
      if (totalMascotasEl) totalMascotasEl.textContent = summary.totalMascotas.toString();
      if (totalCitasEl) totalCitasEl.textContent = summary.totalCitas.toString();
      if (promedioMascotasEl) promedioMascotasEl.textContent = summary.promedioMascotas;

      // Render charts
      renderSpeciesChart(mascotas);
      renderCitasEstadoChart(citas);
      renderClientesChart(clientes);

      // Render recent lists
      renderRecentClients(clientes);
      renderRecentPets(mascotas);

      loadingState?.classList.add('hidden');
      statsContent?.classList.remove('hidden');
    } catch (error) {
      console.error('Error loading stats:', error);
    }
  }

  function renderSpeciesChart(mascotas: Mascota[]) {
    const { labels, data, colors } = computeSpeciesDistribution(mascotas);
    const canvas = document.getElementById('speciesChart') as HTMLCanvasElement | null;
    if (!canvas) return;

    new Chart(canvas, {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{
          data,
          backgroundColor: colors,
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'right',
            labels: {
              color: '#9a8b7c',
              padding: 15,
              usePointStyle: true
            }
          }
        }
      }
    });
  }

  function renderCitasEstadoChart(citas: CitaConDetalles[]) {
    const { labels, data, colors } = computeCitasByEstado(citas);
    const canvas = document.getElementById('citasEstadoChart') as HTMLCanvasElement | null;
    if (!canvas) return;

    new Chart(canvas, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          data,
          backgroundColor: colors,
          borderRadius: 8
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { color: '#9a8b7c' },
            grid: { color: 'rgba(0,0,0,0.06)' }
          },
          x: {
            ticks: { color: '#9a8b7c' },
            grid: { display: false }
          }
        }
      }
    });
  }

  function renderClientesChart(clientes: Cliente[]) {
    const { labels, data } = computeMonthlyClientRegistrations(clientes);
    const canvas = document.getElementById('clientesChart') as HTMLCanvasElement | null;
    if (!canvas) return;

    new Chart(canvas, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label: 'Clientes registrados',
          data,
          borderColor: 'rgba(16, 185, 129, 1)',
          backgroundColor: 'rgba(16, 185, 129, 0.1)',
          fill: true,
          tension: 0.4,
          pointBackgroundColor: 'rgba(16, 185, 129, 1)',
          pointBorderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { color: '#9a8b7c' },
            grid: { color: 'rgba(0,0,0,0.06)' }
          },
          x: {
            ticks: { color: '#9a8b7c' },
            grid: { display: false }
          }
        }
      }
    });
  }

  function renderRecentClients(clientes: Cliente[]) {
    if (!recentClientsEl) return;
    const recent = getRecentClientes(clientes, 5);

    if (recent.length === 0) {
      recentClientsEl.innerHTML = '<p class="text-sm text-center py-4" style="color: #9a8b7c;">No hay clientes registrados</p>';
      return;
    }

    recentClientsEl.innerHTML = recent.map(c => `
      <a href="/mascotas?cliente=${c.id}" class="flex items-center justify-between p-3 bg-white rounded-lg hover:shadow-sm transition-all" style="border: 1px solid #ebe5dd;">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center flex-shrink-0">
            <span class="text-blue-400 font-semibold">${c.nombre.charAt(0)}</span>
          </div>
          <div>
            <p class="text-sm font-medium" style="color: #3d2e22;">${c.nombre}</p>
            <p class="text-xs" style="color: #9a8b7c;">${c.telefono}</p>
          </div>
        </div>
        <span class="text-xs" style="color: #b8a99a;">${formatDate(c.fecha_creacion)}</span>
      </a>
    `).join('');
  }

  function renderRecentPets(mascotas: Mascota[]) {
    if (!recentPetsEl) return;
    const recent = getRecentMascotas(mascotas, 5);

    if (recent.length === 0) {
      recentPetsEl.innerHTML = '<p class="text-sm text-center py-4" style="color: #9a8b7c;">No hay mascotas registradas</p>';
      return;
    }

    recentPetsEl.innerHTML = recent.map(m => `
      <div class="flex items-center justify-between p-3 bg-white rounded-lg" style="border: 1px solid #ebe5dd;">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-amber-500/20 flex items-center justify-center flex-shrink-0">
            <span class="text-lg">${speciesEmojis[m.especie] || '🐾'}</span>
          </div>
          <div>
            <p class="text-sm font-medium" style="color: #3d2e22;">${m.nombre}</p>
            <p class="text-xs" style="color: #9a8b7c;">${m.especie} • ${m.raza || ''}</p>
          </div>
        </div>
        <span class="text-xs" style="color: #b8a99a;">${formatDate(m.fecha_creacion)}</span>
      </div>
    `).join('');
  }

  // Initial load
  loadStats();
</script>
