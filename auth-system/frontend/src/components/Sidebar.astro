<style>
  #sidebar {
    transition: width 200ms ease, transform 200ms ease;
  }
  @media (min-width: 1024px) {
    #sidebar.collapsed {
      width: 4.5rem;
    }
    #sidebar.collapsed .sidebar-label {
      display: none;
    }
    #sidebar.collapsed .sidebar-header {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
    #sidebar.collapsed .sidebar-header .flex {
      justify-content: center;
    }
    #sidebar.collapsed .sidebar-header .w-11 {
      margin: 0 auto;
    }
    #sidebar.collapsed nav a {
      justify-content: center;
      padding-left: 0;
      padding-right: 0;
    }
    #sidebar.collapsed nav a svg {
      margin: 0;
    }
    #sidebar.collapsed #logoutBtn {
      justify-content: center;
      padding-left: 0;
      padding-right: 0;
    }
    #sidebar.collapsed #userAvatar {
      margin: 0;
    }
    #sidebar.collapsed #collapseIcon {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  // ==================== Role-based menu visibility ====================
  const usuarioRaw = localStorage.getItem('usuario');
  const veterinariaRaw = localStorage.getItem('veterinaria');

  const usuario = usuarioRaw ? JSON.parse(usuarioRaw) : null;
  const veterinaria = veterinariaRaw ? JSON.parse(veterinariaRaw) : null;
  const rol = usuario?.rol ?? 'secretaria';

  // Show vet name
  const vetNameEl = document.getElementById('vetName');
  if (vetNameEl && veterinaria?.nombre) vetNameEl.textContent = veterinaria.nombre;

  // Show user name and role
  const sidebarUserName = document.getElementById('sidebarUserName');
  const sidebarRoleLabel = document.getElementById('sidebarRoleLabel');
  const userAvatarEl = document.getElementById('userAvatar');
  const roleBadgeEl = document.getElementById('roleBadge');

  if (sidebarUserName && usuario?.nombre) {
    sidebarUserName.textContent = usuario.nombre;
  }
  if (sidebarRoleLabel) {
    const roleText = rol === 'veterinario' ? 'Veterinario · Cerrar sesión' : 'Secretaria · Cerrar sesión';
    sidebarRoleLabel.textContent = roleText;
  }
  if (roleBadgeEl) {
    roleBadgeEl.textContent = rol === 'veterinario' ? 'Veterinario' : 'Secretaria';
  }
  if (userAvatarEl && usuario?.nombre) {
    userAvatarEl.textContent = usuario.nombre.charAt(0).toUpperCase();
  }

  // Hide secretaria-only menu items for veterinarios
  if (rol === 'veterinario') {
    document.querySelectorAll('.nav-secretaria').forEach(el => {
      (el as HTMLElement).style.display = 'none';
    });
  }

  // ==================== Sidebar collapse toggle ====================
  const SIDEBAR_KEY = 'vetpets_sidebar_collapsed';
  const sidebarEl = document.getElementById('sidebar');
  const collapseBtn = document.getElementById('sidebarCollapseBtn');
  const mainContent = document.querySelector('[data-main-content]') as HTMLElement | null;

  function applySidebarState(collapsed: boolean) {
    if (!sidebarEl) return;
    if (collapsed) {
      sidebarEl.classList.add('collapsed');
      if (mainContent) mainContent.style.marginLeft = '4.5rem';
    } else {
      sidebarEl.classList.remove('collapsed');
      if (mainContent) mainContent.style.marginLeft = '';
    }
  }

  if (window.innerWidth >= 1024) {
    applySidebarState(localStorage.getItem(SIDEBAR_KEY) === 'true');
  }

  collapseBtn?.addEventListener('click', () => {
    const nowCollapsed = !sidebarEl?.classList.contains('collapsed');
    localStorage.setItem(SIDEBAR_KEY, String(nowCollapsed));
    applySidebarState(nowCollapsed);
  });

  // ==================== Logout ====================
  document.getElementById('logoutBtn')?.addEventListener('click', () => {
    localStorage.removeItem('token');
    localStorage.removeItem('veterinaria');
    localStorage.removeItem('usuario');
    window.location.href = '/';
  });

  // ==================== Mobile overlay ====================
  const overlay = document.getElementById('sidebarOverlay');
  overlay?.addEventListener('click', () => {
    sidebarEl?.classList.add('-translate-x-full');
    overlay.classList.add('hidden');
  });
</script>
