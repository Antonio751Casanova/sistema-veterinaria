  function renderTimeGrid() {
    const fecha = fechaCita.value;
    const duracion = getDuracion();
    const selectedTime = horaCita.value;
    const selectedVetId = getVetIdForScheduling();

    // Update the total duration label (always, regardless of date/time selection)
    {
      const h = Math.floor(duracion / 60);
      const m = duracion % 60;
      let label: string;
      if (h > 0 && m > 0)      label = `${h}h ${m}min`;
      else if (h > 0)           label = `${h} hora${h > 1 ? 's' : ''}`;
      else                      label = `${m} min`;
      duracionTotalEl.textContent = `= ${label}`;
    }

    // Update the "Inicio → Fin" label whenever date, duration, or selection changes
    if (selectedTime && fecha) {
      const sel = new Date(`${fecha}T${selectedTime}:00`);
      if (!isNaN(sel.getTime())) {
        const end  = new Date(sel.getTime() + duracion * 60_000);
        const endH = end.getHours().toString().padStart(2, '0');
        const endM = end.getMinutes().toString().padStart(2, '0');
        selectedTimeDisplay.textContent = `${selectedTime} → ${endH}:${endM}`;
        selectedTimeDisplay.classList.remove('hidden');
      }
    } else if (!selectedTime) {
      selectedTimeDisplay.classList.add('hidden');
    }

    if (!fecha) {
      timeGridContainer.innerHTML = '<p class="text-xs text-center py-2" style="color: #94a3b8;">Selecciona una fecha para ver los horarios</p>';
      return;
    }

    if (userRol === 'secretaria' && !selectedVetId) {
      currentSelectionHasConflict = true;
      timeGridContainer.innerHTML = `
        <div class="rounded-lg px-3 py-3 text-xs" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;">
          Selecciona un veterinario para calcular horarios disponibles.
        </div>
      `;
      return;
    }

    const editingId = citaIdInput.value ? parseInt(citaIdInput.value) : null;
    const dayStart = new Date(`${fecha}T00:00:00`);
    const dayEnd = new Date(`${fecha}T23:59:59`);

    // Citas activas del día (excluye la que se edita y las completadas/rechazadas)
    const dayCitas = citas.filter(c => {
      if (editingId && c.id === editingId) return false;
      if (c.estado === 'rechazado' || c.estado === 'completado') return false;
      if (selectedVetId && c.veterinario_asignado_id !== selectedVetId) return false;
      const cf = new Date(c.fecha_hora);
      return cf >= dayStart && cf <= dayEnd;
    });

    // Generate all 15-min slots 07:00 → 19:45
    const allSlots: string[] = [];
    for (let h = 7; h < 20; h++) {
      for (let m = 0; m < 60; m += 15) {
        allSlots.push(`${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}`);
      }
    }

    // Classify each slot
    type SlotInfo = { slot: string; state: 'free' | 'occupied' | 'partial'; tooltip: string };
    const classified: SlotInfo[] = allSlots.map(slot => {
      const slotStart = new Date(`${fecha}T${slot}:00`);
      const slot15End  = new Date(slotStart.getTime() + 15 * 60_000);

      // Is this 15-min window itself occupied?
      const occupier = dayCitas.find(c => {
        const cs = new Date(c.fecha_hora);
        const ce = new Date(cs.getTime() + (c.duracion_minutos ?? getCitaDuracion(c.id)) * 60_000);
        return slotStart < ce && slot15End > cs;
      });
      if (occupier) {
        const oh = new Date(occupier.fecha_hora).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
        return { slot, state: 'occupied', tooltip: `${oh} · ${occupier.nombre_mascota || ''} (${occupier.nombre_cliente || ''}) · ${occupier.tipo_atencion}` };
      }

      // Is the full [slot, slot+duracion) block free?
      const slotFullEnd = new Date(slotStart.getTime() + duracion * 60_000);
      const blockFree = !dayCitas.some(c => {
        const cs = new Date(c.fecha_hora);
        const ce = new Date(cs.getTime() + (c.duracion_minutos ?? getCitaDuracion(c.id)) * 60_000);
        return slotStart < ce && slotFullEnd > cs;
      });

      if (!blockFree) {
        return { slot, state: 'partial', tooltip: `Hora libre, pero la duración de ${duracion} min se empalmaría con otra cita` };
      }
      return { slot, state: 'free', tooltip: '' };
    });

    const freeCount  = classified.filter(s => s.state === 'free').length;
    const busyCount  = classified.filter(s => s.state === 'occupied').length;

    // Detectar si la selección actual se empalma con alguna cita existente
    let hasSelectionConflict = false;
    if (selectedTime) {
      const selStart = new Date(`${fecha}T${selectedTime}:00`);
      const selEnd   = new Date(selStart.getTime() + duracion * 60_000);
      hasSelectionConflict = dayCitas.some(c => {
        const cs = new Date(c.fecha_hora);
        const ce = new Date(cs.getTime() + (c.duracion_minutos ?? getCitaDuracion(c.id)) * 60_000);
        return selStart < ce && selEnd > cs;
      });
    }
    currentSelectionHasConflict = hasSelectionConflict;

    function slotBtn({ slot, state, tooltip }: SlotInfo): string {
      const isSelected = slot === selectedTime;

      // Is this slot within the duration block of the selected start time?
      const isInSelectedRange = !isSelected && !!selectedTime && (() => {
        const selStart = new Date(`${fecha}T${selectedTime}:00`);
        const selEnd   = new Date(selStart.getTime() + duracion * 60_000);
        const s        = new Date(`${fecha}T${slot}:00`);
        return s > selStart && s < selEnd;
      })();

      // Is this slot exactly the END boundary of the selected appointment?
      const isEndBoundary = !isSelected && !isInSelectedRange && !!selectedTime && (() => {
        const selStart = new Date(`${fecha}T${selectedTime}:00`);
        const selEnd   = new Date(selStart.getTime() + duracion * 60_000);
        const s        = new Date(`${fecha}T${slot}:00`);
        return s.getTime() === selEnd.getTime();
      })();

      if (isSelected) {
        if (hasSelectionConflict) {
          return `<button type="button" onclick="window.selectTimeSlot('${slot}')" title="¡Conflicto de horario! La duración se empalma con otra cita"
            class="px-2.5 py-1.5 text-xs rounded-lg font-bold bg-red-500 border-2 border-red-300 text-white ring-2 ring-red-400/50 ring-offset-1 ring-offset-white">
            ${slot}
          </button>`;
        }
        return `<button type="button" onclick="window.selectTimeSlot('${slot}')" title="Inicio de la cita"
          class="px-2.5 py-1.5 text-xs rounded-lg font-bold bg-blue-500 border-2 border-blue-300 text-white ring-2 ring-blue-400/50 ring-offset-1 ring-offset-white">
          ${slot}
        </button>`;
      }
      if (isInSelectedRange) {
        if (state === 'occupied') {
          return `<button type="button" disabled title="¡Conflicto! ${tooltip}"
            class="px-2.5 py-1.5 text-xs rounded-lg bg-red-500/30 border-2 border-red-500/50 text-red-600 cursor-not-allowed font-bold">
            ${slot}
          </button>`;
        }
        return `<button type="button" disabled title="Ocupado por esta cita (${duracion} min)"
          class="px-2.5 py-1.5 text-xs rounded-lg bg-blue-500/25 border border-blue-500/40 text-blue-600/70 cursor-not-allowed">
          ${slot}
        </button>`;
      }
      if (isEndBoundary) {
        return `<button type="button" onclick="window.selectTimeSlot('${slot}')" title="Fin de la cita — disponible para siguiente"
          class="px-2.5 py-1.5 text-xs rounded-lg bg-blue-500/10 border border-dashed border-blue-500/50 text-blue-600/60 hover:bg-blue-500/25 transition-colors">
          ${slot} ←
        </button>`;
      }
      if (state === 'occupied') {
        return `<button type="button" disabled title="${tooltip}"
          class="px-2.5 py-1.5 text-xs rounded-lg bg-red-500/20 border border-red-500/40 text-red-400 cursor-not-allowed opacity-75">
          ${slot}
        </button>`;
      }
      if (state === 'partial') {
        return `<button type="button" disabled title="${tooltip}"
          class="px-2.5 py-1.5 text-xs rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-500/70 cursor-not-allowed opacity-60">
          ${slot}
        </button>`;
      }
      // free
      return `<button type="button" onclick="window.selectTimeSlot('${slot}')" title="Disponible"
        class="px-2.5 py-1.5 text-xs rounded-lg hover:bg-blue-500/20 border hover:border-blue-500/50 transition-colors" style="background: #f8fafc; border-color: #e2e8f0; color: #9a8b7c;">
        ${slot}
      </button>`;
    }

    const morning   = classified.filter(s => parseInt(s.slot) < 12);
    const afternoon = classified.filter(s => parseInt(s.slot) >= 12);

    timeGridContainer.innerHTML = `
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs" style="color: #9a8b7c;">${freeCount} horarios libres · ${busyCount} ocupados</span>
        ${selectedTime
          ? `<span class="text-xs font-medium ${hasSelectionConflict ? 'text-red-500' : 'text-blue-600'}">Seleccionado: <strong>${selectedTime}</strong>${hasSelectionConflict ? ' — ¡Conflicto!' : ''}</span>`
          : '<span class="text-xs italic" style="color: #94a3b8;">Haz clic en un bloque verde para elegir la hora</span>'}
      </div>
      ${hasSelectionConflict ? `
        <div class="mb-3 flex items-start gap-2 bg-red-50 border border-red-200 rounded-lg px-3 py-2.5">
          <svg class="w-4 h-4 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <p class="text-red-600 text-xs font-medium">La hora seleccionada se empalma con otra cita. Los bloques rojos dentro del rango indican el conflicto. Elige una hora diferente.</p>
        </div>
      ` : ''}
      <div class="mb-3">
        <p class="text-xs uppercase tracking-wider font-medium mb-2" style="color: #9a8b7c;">Mañana</p>
        <div class="flex flex-wrap gap-1.5">${morning.map(slotBtn).join('')}</div>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider font-medium mb-2" style="color: #9a8b7c;">Tarde</p>
        <div class="flex flex-wrap gap-1.5">${afternoon.map(slotBtn).join('')}</div>
      </div>
    `;
  }

  (window as any).selectTimeSlot = (slot: string) => {
    horaCita.value = slot;
    renderTimeGrid();
  };

  // Apply filters
  function applyFilters() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    const searchDigits = searchTerm.replace(/\D/g, '');
    const estadoValue = estadoFilter.value;
    const fechaValue = fechaFilter.value;
    const vetFilterValue = vetFilter.value;

    filteredCitas = citas.filter(cita => {
      // Search filter
      let matchesSearch = true;
      if (searchTerm) {
        const phoneMatch = searchDigits.length >= 3 && (cita.telefono_cliente || '').replace(/\D/g, '').includes(searchDigits);
        matchesSearch =
          cita.nombre_mascota?.toLowerCase().includes(searchTerm) ||
          cita.nombre_cliente?.toLowerCase().includes(searchTerm) ||
          phoneMatch ||
          cita.tipo_atencion.toLowerCase().includes(searchTerm) ||
          false;
      }

      // Estado filter
      let matchesEstado = true;
      if (estadoValue) {
        matchesEstado = cita.estado === estadoValue;
      }

      // Fecha filter
      let matchesFecha = true;
      if (fechaValue) {
        // Extraer fecha directamente del string para evitar problemas de timezone
        const citaFechaStr = cita.fecha_hora.split('T')[0];
        matchesFecha = citaFechaStr === fechaValue;
      }

      // Vet filter (secretaria only)
      let matchesVet = true;
      if (vetFilterValue && userRol === 'secretaria') {
        matchesVet = cita.veterinario_asignado_id?.toString() === vetFilterValue;
      }

      return matchesSearch && matchesEstado && matchesFecha && matchesVet;
    });

    // Sort by date descending
    filteredCitas.sort((a, b) => new Date(b.fecha_hora).getTime() - new Date(a.fecha_hora).getTime());

    currentPage = 1;
    if (pendingFocusCitaId) {
      const index = filteredCitas.findIndex(c => c.id === pendingFocusCitaId);
      if (index >= 0) {
        currentPage = Math.floor(index / pageSize) + 1;
      }
    }
    renderTable();
  }

  // Render table
  function renderTable() {
    if (filteredCitas.length === 0) {
      emptyState.classList.remove('hidden');
      tableContainer.classList.add('hidden');
      paginationContainer.classList.add('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    tableContainer.classList.remove('hidden');
    paginationContainer.classList.remove('hidden');

    const totalPages = Math.ceil(filteredCitas.length / pageSize);
    const start = (currentPage - 1) * pageSize;
    const end = Math.min(start + pageSize, filteredCitas.length);
    const pageItems = filteredCitas.slice(start, end);

    citasTableBody.innerHTML = pageItems.map(cita => {
      const fecha = new Date(cita.fecha_hora);
      const fechaStr = fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
      const horaStr = fecha.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
      const emoji = speciesEmojis[cita.especie_mascota || ''] || '🐾';
      const badgeClass = estadoBadges[cita.estado] || 'bg-gray-500/20 text-gray-600';
      const estadoLabel = estadoLabels[cita.estado] || cita.estado;
      const isTarget = pendingFocusCitaId === cita.id;

      return `
        <tr id="cita-row-${cita.id}" class="hover:bg-black/[0.02] transition-colors ${isTarget ? 'cita-row-focus' : ''}">
          <td class="px-4 py-3">
            <div class="text-sm font-medium" style="color: #0f172a;">${fechaStr}</div>
            <div class="text-xs" style="color: #9a8b7c;">${horaStr}</div>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center space-x-2">
              <span class="text-lg">${emoji}</span>
              <div>
                <a href="/mascotas?id=${cita.mascota_id}" class="text-sm font-medium hover:text-blue-600" style="color: #0f172a;">${cita.nombre_mascota || 'Sin nombre'}</a>
                <div class="text-xs" style="color: #9a8b7c;">${cita.especie_mascota || ''}</div>
              </div>
            </div>
          </td>
          <td class="px-4 py-3">
            <div class="text-sm" style="color: #0f172a;">${cita.nombre_cliente || 'Sin cliente'}</div>
            ${cita.telefono_cliente ? `
              <a href="https://wa.me/${cita.telefono_cliente.replace(/\D/g, '')}" target="_blank" class="text-blue-600 hover:text-blue-700 text-xs flex items-center gap-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                ${cita.telefono_cliente}
              </a>
            ` : ''}
          </td>
          <td class="px-4 py-3 text-sm" style="color: #0f172a;">${cita.tipo_atencion}</td>
          <td class="px-4 py-3 text-sm" style="color: #0f172a;">${cita.costo ? `$${parseFloat(cita.costo).toFixed(2)}` : '-'}</td>
          <td class="px-4 py-3">
            <span class="px-2 py-1 rounded-full text-xs font-medium ${badgeClass}">${estadoLabel}</span>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center justify-center space-x-1">
              <button onclick="window.editCita(${cita.id})" class="p-1.5 hover:bg-black/5 rounded-lg transition-colors" style="color: #9a8b7c;" title="Editar">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
              </button>
              <button onclick="window.openWhatsappModal(${cita.id})" class="p-1.5 text-blue-500 hover:text-blue-600 hover:bg-black/5 rounded-lg transition-colors" title="WhatsApp">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </button>
              <button onclick="window.openEmailModal(${cita.id})" class="p-1.5 text-sky-500 hover:text-sky-600 hover:bg-black/5 rounded-lg transition-colors ${cita.email_cliente ? '' : 'opacity-50 cursor-not-allowed'}" title="Email" ${!cita.email_cliente ? 'disabled' : ''}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </button>
              <button onclick="window.deleteCita(${cita.id})" class="p-1.5 text-red-400 hover:text-red-500 hover:bg-black/5 rounded-lg transition-colors" title="Eliminar">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    // Update pagination
    currentPageDisplays.forEach(el => el.textContent = currentPage.toString());
    totalPagesDisplays.forEach(el => el.textContent = totalPages.toString());
    showingFromEls.forEach(el => el.textContent = (start + 1).toString());
    showingToEls.forEach(el => el.textContent = end.toString());
    totalItemsEls.forEach(el => el.textContent = filteredCitas.length.toString());

    prevPageBtns.forEach(btn => btn.disabled = currentPage === 1);
    nextPageBtns.forEach(btn => btn.disabled = currentPage === totalPages);

    if (pendingFocusCitaId) {
      const targetRow = document.getElementById(`cita-row-${pendingFocusCitaId}`);
      if (targetRow) {
        requestAnimationFrame(() => {
          targetRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
        pendingFocusCitaId = null;
      }
    }
  }

  // Pagination events
  prevPageBtns.forEach(btn => btn.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderTable();
    }
  }));

  nextPageBtns.forEach(btn => btn.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredCitas.length / pageSize);
    if (currentPage < totalPages) {
      currentPage++;
      renderTable();
    }
  }));

  // Filter events
  searchInput.addEventListener('input', applyFilters);
  estadoFilter.addEventListener('change', applyFilters);
  fechaFilter.addEventListener('change', applyFilters);
  vetFilter.addEventListener('change', () => {
    applyFilters();
    // Show report button only when a vet is selected
    if (vetFilter.value) {
      reporteVetBtn.classList.remove('hidden');
      reporteVetBtn.style.display = 'flex';
    } else {
      reporteVetBtn.classList.add('hidden');
    }
  });

  // Report button — generates email with that vet's filtered citas
  reporteVetBtn.addEventListener('click', () => {
    const vetId = parseInt(vetFilter.value);
    const vet = veterinarios.find(v => v.id === vetId);
    if (!vet) return;

    const now = new Date();
    const fechaHoy = now.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const estadoActivo = estadoFilter.value;
    const fechaActiva = fechaFilter.value;

    const vetCitas = filteredCitas.filter(c => c.veterinario_asignado_id === vetId);

    const estadoLabels: Record<string, string> = {
      pendiente: 'Pendiente', confirmado: 'Confirmado', en_espera: 'En Espera',
      completado: 'Completado', rechazado: 'Rechazado'
    };

    let periodoInfo = '';
    if (fechaActiva) {
      periodoInfo = `Fecha: ${new Date(fechaActiva + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })}\n`;
    }
    if (estadoActivo) {
      periodoInfo += `Estado: ${estadoLabels[estadoActivo] || estadoActivo}\n`;
    }

    let body = `Reporte de citas — Dr./Dra. ${vet.nombre}\n`;
    body += `Generado el: ${fechaHoy}\n`;
    if (periodoInfo) body += periodoInfo;
    body += `Total: ${vetCitas.length} cita(s)\n`;
    body += '─'.repeat(40) + '\n\n';

    if (vetCitas.length === 0) {
      body += 'No hay citas en el período seleccionado.\n';
    } else {
      vetCitas.forEach((c, i) => {
        const fechaStr = new Date(c.fecha_hora).toLocaleDateString('es-MX', {
          weekday: 'short', day: 'numeric', month: 'short', year: 'numeric'
        });
        const horaStr = new Date(c.fecha_hora).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
        body += `${i + 1}. ${c.nombre_mascota} (${c.especie_mascota}) — ${c.nombre_cliente}\n`;
        body += `   📅 ${fechaStr} a las ${horaStr}\n`;
        body += `   🩺 ${c.tipo_atencion}  |  Estado: ${estadoLabels[c.estado] || c.estado}\n`;
        if (c.descripcion) body += `   Notas: ${c.descripcion}\n`;
        body += '\n';
      });
    }

    const subject = encodeURIComponent(`Reporte de citas — ${vet.nombre} — ${fechaHoy}`);
    const mailtoUrl = `mailto:${vet.email || ''}?subject=${subject}&body=${encodeURIComponent(body)}`;
    window.open(mailtoUrl, '_blank');
  });

  // Time grid triggers
  fechaCita.addEventListener('change', renderTimeGrid);
  veterinarioAsignado.addEventListener('change', () => {
    formError.classList.add('hidden');
    renderTimeGrid();
  });
  duracionHoras.addEventListener('input', renderTimeGrid);
  duracionMinutos.addEventListener('input', renderTimeGrid);

  // Prevent accidental scroll-wheel changes on duration number inputs
  duracionHoras.addEventListener('wheel', (e) => e.preventDefault(), { passive: false });
  duracionMinutos.addEventListener('wheel', (e) => e.preventDefault(), { passive: false });

  // Snap manually typed minutes to nearest multiple of 15 (with carry-over to hours)
  duracionMinutos.addEventListener('blur', () => {
    let m = parseInt(duracionMinutos.value) || 0;
    m = Math.round(m / 15) * 15;
    if (m >= 60) {
      const h = (parseInt(duracionHoras.value) || 0) + Math.floor(m / 60);
      duracionHoras.value = Math.min(h, 8).toString();
      m = m % 60;
    }
    m = Math.max(0, Math.min(m, 45));
    duracionMinutos.value = m.toString();
    renderTimeGrid();
  });

  // Toggle visibility of the time grid
  toggleTimeGridBtn.addEventListener('click', () => {
    timeGridVisible = !timeGridVisible;
    timeGridContainer.style.display = timeGridVisible ? '' : 'none';
    toggleTimeGridIcon.style.transform = timeGridVisible ? 'rotate(0deg)' : 'rotate(-90deg)';
  });

  // Modal functions
  function openModal(isEdit = false) {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modalTitle.textContent = isEdit ? 'Editar Cita' : 'Nueva Cita';
    formError.classList.add('hidden');
    // Always show the time grid when opening the modal
    timeGridVisible = true;
    timeGridContainer.style.display = '';
    toggleTimeGridIcon.style.transform = 'rotate(0deg)';
    if (!isEdit) {
      citaForm.reset();
      citaIdInput.value = '';
      // Reset cliente - IMPORTANTE: mostrar el input de búsqueda
      selectedClienteInfo.classList.add('hidden');
      clienteIdCita.value = '';
      clienteSearch.value = '';
      clienteSearch.classList.remove('hidden');
      selectedClienteId = null;
      // Reset mascota
      mascotaSection.classList.add('hidden');
      selectedMascotaInfo.classList.add('hidden');
      mascotaIdInput.value = '';
      mascotaSelect.selectedIndex = 0;
      mascotasDelCliente = [];
      // Set default date to today
      fechaCita.value = new Date().toISOString().split('T')[0];
      // Reset duracion, hora y time grid
      setDuracion(60);
      horaCita.value = '';
      selectedTimeDisplay.classList.add('hidden');
      renderTimeGrid();
    }
  }

  function closeModalFn() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  addCitaBtn.addEventListener('click', () => openModal(false));
  closeModal.addEventListener('click', closeModalFn);
  cancelBtn.addEventListener('click', closeModalFn);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModalFn(); });

  if (userRol === 'secretaria') {
    addWaitlistBtn?.addEventListener('click', () => openWaitlistModal(false));
    closeWaitlistModal?.addEventListener('click', closeWaitlistModalFn);
    cancelWaitlistBtn?.addEventListener('click', closeWaitlistModalFn);
    waitlistModal?.addEventListener('click', (e) => {
      if (e.target === waitlistModal) closeWaitlistModalFn();
    });

    waitlistForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      waitlistError.classList.add('hidden');

      const mascotaId = parseInt(waitlistMascota.value || '', 10);
      if (Number.isNaN(mascotaId) || mascotaId <= 0) {
        waitlistError.textContent = 'Selecciona una mascota';
        waitlistError.classList.remove('hidden');
        return;
      }

      if (!waitlistTipo.value.trim()) {
        waitlistError.textContent = 'Especifica el tipo de atencion';
        waitlistError.classList.remove('hidden');
        return;
      }

      const duracion = parseInt(waitlistDuracion.value || '60', 10);
      const prioridad = parseInt(waitlistPrioridad.value || '0', 10);
      const horaInicioRaw = waitlistHoraInicio.value.trim();
      const horaFinRaw = waitlistHoraFin.value.trim();
      const horaInicio = horaInicioRaw === '' ? undefined : parseInt(horaInicioRaw, 10);
      const horaFin = horaFinRaw === '' ? undefined : parseInt(horaFinRaw, 10);
      const prefVet = waitlistVeterinario.value ? parseInt(waitlistVeterinario.value, 10) : undefined;

      if ((horaInicio != null && Number.isNaN(horaInicio)) || (horaFin != null && Number.isNaN(horaFin))) {
        waitlistError.textContent = 'Las horas preferidas no son validas';
        waitlistError.classList.remove('hidden');
        return;
      }

      if (horaInicio != null && horaFin != null && horaInicio > horaFin) {
        waitlistError.textContent = 'La hora de inicio no puede ser mayor que la hora de fin';
        waitlistError.classList.remove('hidden');
        return;
      }

      const payload: ListaEsperaCreate = {
        mascota_id: mascotaId,
        tipo_atencion: waitlistTipo.value.trim(),
        duracion_minutos: duracion,
        prioridad,
        hora_inicio_preferida: horaInicio,
        hora_fin_preferida: horaFin,
        notas: waitlistNotas.value.trim() || undefined,
        preferencia_veterinario_id: prefVet
      };

      try {
        const itemId = parseInt(waitlistIdInput.value || '', 10);
        if (!Number.isNaN(itemId) && itemId > 0) {
          await actualizarItemListaEspera(itemId, payload);
        } else {
          await crearItemListaEspera(payload);
        }
        closeWaitlistModalFn();
        await loadWaitlist();
      } catch (error: any) {
        waitlistError.textContent = error.message || 'No se pudo guardar el elemento';
        waitlistError.classList.remove('hidden');
      }
    });
  }

  // Cliente search with type filter
  clienteSearch.addEventListener('input', () => {
    const term = clienteSearch.value.trim();
    const searchType = clienteSearchType.value;
    
    if (term.length < 1) {
      clienteDropdown.classList.add('hidden');
      return;
    }

    let matches: Cliente[] = [];
    
    if (searchType === 'id') {
      // Búsqueda exacta por ID
      matches = clientes.filter(c => c.id.toString() === term);
    } else if (searchType === 'telefono') {
      // Búsqueda por teléfono (solo números)
      const cleanTerm = term.replace(/\D/g, '');
      matches = clientes.filter(c => c.telefono.replace(/\D/g, '').includes(cleanTerm));
    } else {
      // Búsqueda por nombre
      matches = clientes.filter(c => c.nombre.toLowerCase().includes(term.toLowerCase()));
    }
    
    matches = matches.slice(0, 10);

    if (matches.length === 0) {
      clienteDropdown.innerHTML = '<div class="px-3 py-2 text-sm" style="color: #9a8b7c;">No se encontraron resultados</div>';
      clienteDropdown.classList.remove('hidden');
      return;
    }

    clienteDropdown.innerHTML = matches.map(c => `
      <div class="px-3 py-2 hover:bg-black/5 cursor-pointer flex items-center space-x-2" data-id="${c.id}">
        <div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center">
          <svg class="w-4 h-4" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm" style="color: #0f172a;"><span class="text-xs" style="color: #9a8b7c;">#${c.id}</span> ${c.nombre}</p>
          <p class="text-xs" style="color: #9a8b7c;">${c.telefono} ${c.email ? '- ' + c.email : ''}</p>
        </div>
      </div>
    `).join('');
    clienteDropdown.classList.remove('hidden');
  });

  // Update placeholder when search type changes
  clienteSearchType.addEventListener('change', () => {
    const type = clienteSearchType.value;
    if (type === 'id') {
      clienteSearch.placeholder = 'Ingresa el ID del cliente...';
    } else if (type === 'telefono') {
      clienteSearch.placeholder = 'Ingresa el telefono...';
    } else {
      clienteSearch.placeholder = 'Escribe el nombre...';
    }
    clienteSearch.value = '';
    clienteDropdown.classList.add('hidden');
  });

  clienteDropdown.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-id]');
    if (!target) return;

    const id = parseInt(target.getAttribute('data-id') || '0');
    const cliente = clientes.find(c => c.id === id);
    if (!cliente) return;

    selectCliente(cliente);
    clienteDropdown.classList.add('hidden');
  });

  function selectCliente(cliente: Cliente) {
    selectedClienteId = cliente.id;
    clienteIdCita.value = cliente.id.toString();
    clienteSearch.value = cliente.nombre;
    clienteSearch.classList.add('hidden');
    selectedClienteInfo.classList.remove('hidden');
    clienteNombreSelected.textContent = cliente.nombre;
    clienteContacto.textContent = `${cliente.telefono}${cliente.email ? ' - ' + cliente.email : ''}`;

    // Load mascotas for this cliente
    mascotasDelCliente = mascotas.filter(m => m.cliente_id === cliente.id);
    
    // Show mascota section
    mascotaSection.classList.remove('hidden');
    updateMascotaSelect();
  }

  clearCliente.addEventListener('click', () => {
    selectedClienteId = null;
    clienteIdCita.value = '';
    clienteSearch.value = '';
    clienteSearch.classList.remove('hidden');
    selectedClienteInfo.classList.add('hidden');
    mascotaSection.classList.add('hidden');
    selectedMascotaInfo.classList.add('hidden');
    mascotaIdInput.value = '';
    mascotasDelCliente = [];
  });

  document.addEventListener('click', (e) => {
    if (!clienteSearch.contains(e.target as Node) && !clienteDropdown.contains(e.target as Node)) {
      clienteDropdown.classList.add('hidden');
    }
  });

  // Mascota selection with filter
  function updateMascotaSelect() {
    const searchType = mascotaSearchType.value;
    const term = mascotaSearchInput.value.trim();
    
    let filtered = mascotasDelCliente;
    
    if (term.length > 0) {
      if (searchType === 'id') {
        filtered = mascotasDelCliente.filter(m => m.id.toString() === term);
      } else if (searchType === 'especie') {
        filtered = mascotasDelCliente.filter(m => m.especie.toLowerCase().includes(term.toLowerCase()));
      } else {
        filtered = mascotasDelCliente.filter(m => m.nombre.toLowerCase().includes(term.toLowerCase()));
      }
    }

    mascotaSelect.innerHTML = '<option value="" class="bg-white">-- Selecciona una mascota (' + filtered.length + ' disponibles) --</option>' +
      filtered.map(m => `
        <option value="${m.id}" class="bg-white">${speciesEmojis[m.especie] || ''} #${m.id} ${m.nombre} (${m.especie} - ${m.raza})</option>
      `).join('');

    if (mascotaIdInput.value) {
      mascotaSelect.value = mascotaIdInput.value;
    }
  }

  // Mascota search filter
  mascotaSearchInput.addEventListener('input', updateMascotaSelect);
  mascotaSearchType.addEventListener('change', () => {
    const type = mascotaSearchType.value;
    if (type === 'id') {
      mascotaSearchInput.placeholder = 'Filtrar por ID...';
    } else if (type === 'especie') {
      mascotaSearchInput.placeholder = 'Filtrar por especie...';
    } else {
      mascotaSearchInput.placeholder = 'Filtrar por nombre...';
    }
    mascotaSearchInput.value = '';
    updateMascotaSelect();
  });

  mascotaSelect.addEventListener('change', () => {
    const id = parseInt(mascotaSelect.value);
    if (!id) {
      mascotaIdInput.value = '';
      selectedMascotaInfo.classList.add('hidden');
      return;
    }

    const mascota = mascotasDelCliente.find(m => m.id === id);
    if (!mascota) return;

    mascotaIdInput.value = mascota.id.toString();
    selectedMascotaInfo.classList.remove('hidden');
    const emoji = speciesEmojis[mascota.especie] || '';
    mascotaAvatar.innerHTML = `<span class="text-2xl">${emoji}</span>`;
    mascotaNombre.textContent = mascota.nombre;
    mascotaDetalles.textContent = `${mascota.especie} - ${mascota.raza} - ${mascota.edad || 0} años`;
  });

  // Form submit
  citaForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');

    if (!selectedClienteId) {
      formErrorText.textContent = 'Por favor selecciona un cliente';
      formError.classList.remove('hidden');
      return;
    }

    const mascotaId = parseInt(mascotaIdInput.value);
    if (!mascotaId) {
      formErrorText.textContent = 'Por favor selecciona una mascota';
      formError.classList.remove('hidden');
      return;
    }

    const fecha = fechaCita.value;
    const hora = horaCita.value;
    if (!fecha || !hora) {
      formErrorText.textContent = 'Por favor completa la fecha y hora';
      formError.classList.remove('hidden');
      return;
    }

    if (!tipoAtencion.value.trim()) {
      formErrorText.textContent = 'Por favor selecciona o escribe el tipo de atencion';
      formError.classList.remove('hidden');
      return;
    }

    if (userRol === 'secretaria' && !veterinarioAsignado.value) {
      formErrorText.textContent = 'Por favor selecciona un veterinario para la cita';
      formError.classList.remove('hidden');
      return;
    }

    const fechaHora = `${fecha}T${hora}:00`;

    if (currentSelectionHasConflict) {
      formErrorText.textContent = 'La hora seleccionada se empalma con otra cita. Por favor elige una hora diferente.';
      formError.classList.remove('hidden');
      return;
    }

    const citaData: CitaCreate = {
      mascota_id: mascotaId,
      fecha_hora: fechaHora,
      duracion_minutos: getDuracion(),
      tipo_atencion: tipoAtencion.value,
      estado: estadoCita.value,
      costo: undefined,
      descripcion: detallesCita.value || undefined,
      veterinario_asignado_id: veterinarioAsignado.value ? parseInt(veterinarioAsignado.value) : undefined
    };

    try {
      const id = citaIdInput.value ? parseInt(citaIdInput.value) : null;
      if (id) {
        await actualizarCita(id, citaData as CitaUpdate);
        saveCitaDuracion(id, citaData.duracion_minutos || 60);
      } else {
        const newCita = await crearCita(citaData);
        saveCitaDuracion(newCita.id, citaData.duracion_minutos || 60);
      }
      closeModalFn();
      await loadCitas();
    } catch (error: any) {
      formErrorText.textContent = error.message || 'Error al guardar la cita';
      formError.classList.remove('hidden');
    }
  });

  // Edit cita
  (window as any).editCita = (id: number) => {
    const cita = citas.find(c => c.id === id);
    if (!cita) return;

    openModal(true);
    citaIdInput.value = cita.id.toString();

    const fecha = new Date(cita.fecha_hora);
    fechaCita.value = fecha.toISOString().split('T')[0];
    const horaStr = fecha.toTimeString().slice(0, 5);
    horaCita.value = horaStr;
    tipoAtencion.value = cita.tipo_atencion;
    estadoCita.value = cita.estado;
    detallesCita.value = cita.descripcion || '';
    if (cita.veterinario_asignado_id) {
      veterinarioAsignado.value = cita.veterinario_asignado_id.toString();
    } else {
      veterinarioAsignado.value = '';
    }

    // Find cliente from mascota
    const mascota = mascotas.find(m => m.id === cita.mascota_id);
    if (mascota && mascota.cliente_id) {
      const cliente = clientes.find(c => c.id === mascota.cliente_id);
      if (cliente) {
        selectedClienteId = cliente.id;
        clienteIdCita.value = cliente.id.toString();
        clienteSearch.value = cliente.nombre;
        clienteSearch.classList.add('hidden');
        selectedClienteInfo.classList.remove('hidden');
        clienteNombreSelected.textContent = cliente.nombre;
        clienteContacto.textContent = `${cliente.telefono}${cliente.email ? ' - ' + cliente.email : ''}`;
        
        // Load mascotas for this cliente
        mascotasDelCliente = mascotas.filter(m => m.cliente_id === cliente.id);
        mascotaSection.classList.remove('hidden');
        updateMascotaSelect();
      }
    }

    // Select mascota
    mascotaIdInput.value = cita.mascota_id.toString();
    mascotaSelect.value = cita.mascota_id.toString();
    selectedMascotaInfo.classList.remove('hidden');
    const emoji = speciesEmojis[cita.especie_mascota || ''] || '';
    mascotaAvatar.innerHTML = `<span class="text-2xl">${emoji}</span>`;
    mascotaNombre.textContent = cita.nombre_mascota || 'Sin nombre';
    mascotaDetalles.textContent = cita.especie_mascota || '';

    // Load stored duration for this cita and render the time grid
    setDuracion(cita.duracion_minutos ?? getCitaDuracion(cita.id));
    renderTimeGrid();
  };

  // Delete cita
  (window as any).deleteCita = (id: number) => {
    deleteCitaId = id;
    deleteModal.classList.remove('hidden');
    deleteModal.classList.add('flex');
  };

  cancelDelete.addEventListener('click', () => {
    deleteModal.classList.add('hidden');
    deleteModal.classList.remove('flex');
    deleteCitaId = null;
  });

  confirmDelete.addEventListener('click', async () => {
    if (!deleteCitaId) return;
    try {
      await eliminarCita(deleteCitaId);
      deleteModal.classList.add('hidden');
      deleteModal.classList.remove('flex');
      deleteCitaId = null;
      await loadCitas();
    } catch (error) {
      console.error('Error deleting cita:', error);
    }
  });

  // WhatsApp modal
  (window as any).openWhatsappModal = (id: number) => {
    const cita = citas.find(c => c.id === id);
    if (!cita) return;

    whatsappCita = cita;
    whatsappMessage.value = generarMensajeWhatsApp(cita);
    whatsappModal.classList.remove('hidden');
    whatsappModal.classList.add('flex');
  };

  closeWhatsapp.addEventListener('click', () => {
    whatsappModal.classList.add('hidden');
    whatsappModal.classList.remove('flex');
    whatsappCita = null;
  });

  cancelWhatsapp.addEventListener('click', () => {
    whatsappModal.classList.add('hidden');
    whatsappModal.classList.remove('flex');
    whatsappCita = null;
  });

  sendWhatsapp.addEventListener('click', () => {
    if (!whatsappCita?.telefono_cliente) return;
    abrirWhatsApp(whatsappCita.telefono_cliente, whatsappMessage.value);
    whatsappModal.classList.add('hidden');
    whatsappModal.classList.remove('flex');
    whatsappCita = null;
  });

  whatsappModal.addEventListener('click', (e) => {
    if (e.target === whatsappModal) {
      whatsappModal.classList.add('hidden');
      whatsappModal.classList.remove('flex');
      whatsappCita = null;
    }
  });

  // Email modal
  (window as any).openEmailModal = (id: number) => {
    const cita = citas.find(c => c.id === id);
    if (!cita || !cita.email_cliente) return;

    emailCita = cita;
    const { subject, body } = generarMensajeEmail(cita);
    emailSubject.value = subject;
    emailBody.value = body;
    emailModal.classList.remove('hidden');
    emailModal.classList.add('flex');
  };

  closeEmail.addEventListener('click', () => {
    emailModal.classList.add('hidden');
    emailModal.classList.remove('flex');
    emailCita = null;
  });

  cancelEmail.addEventListener('click', () => {
    emailModal.classList.add('hidden');
    emailModal.classList.remove('flex');
    emailCita = null;
  });

  sendEmail.addEventListener('click', () => {
    if (!emailCita?.email_cliente) return;
    abrirEmail(emailCita.email_cliente, emailSubject.value, emailBody.value);
    emailModal.classList.add('hidden');
    emailModal.classList.remove('flex');
    emailCita = null;
  });

  emailModal.addEventListener('click', (e) => {
    if (e.target === emailModal) {
      emailModal.classList.add('hidden');
      emailModal.classList.remove('flex');
      emailCita = null;
    }
  });

  // Initial load
  async function initPage() {
    if (initialSearchQuery) {
      searchInput.value = initialSearchQuery;
    }

    await Promise.all([
      loadClientes(),
      loadMascotas(),
      loadVeterinarios(),
      loadCitas()
    ]);

    await loadWaitlist();

    if (!pendingWaitlistPrefillHandled && !Number.isNaN(prefillWaitlistId) && prefillWaitlistId > 0) {
      pendingWaitlistPrefillHandled = true;
      try {
        const item = await obtenerItemListaEspera(prefillWaitlistId);
        applyWaitlistPrefill(item);
      } catch (error) {
        console.error('Error applying waitlist prefill:', error);
      }
    }
  }

  initPage();

  // Polling: detectar confirmaciones de clientes cada 30 segundos
  setInterval(() => {
    loadCitas();
    loadWaitlist();
  }, 30_000);
</script>
