---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Citas - Sistema Veterinarias">
  <Sidebar />
  <div class="lg:ml-64 min-h-screen transition-[margin] duration-200" style="background: #f1f5f9;" data-main-content>
    <!-- Sticky Header -->
    <header class="sticky top-0 z-30 backdrop-blur-md" style="background: rgba(255,255,255,0.8); border-bottom: 1px solid #e2e8f0;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <button id="hamburgerBtn" class="lg:hidden p-2 rounded-lg hover:bg-black/5" style="color: #0f172a;">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          <div>
            <h1 class="text-xl md:text-2xl font-bold" style="color: #1e293b;">Gestión de Citas</h1>
            <p class="text-sm" style="color: #94a3b8;">Agenda y administra las citas de la veterinaria</p>
          </div>
        </div>
        <button
          id="addCitaBtn"
          class="px-4 md:px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-xl hover:from-blue-600 hover:to-blue-700 transition-all duration-200 flex items-center space-x-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Nueva Cita</span>
        </button>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">

      <!-- Stats Summary -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4" style="border: 1px solid #e2e8f0;">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs" style="color: #9a8b7c;">Total Citas</p>
              <p id="totalCitas" class="text-2xl font-bold mt-1" style="color: #0f172a;">0</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center">
              <span class="text-xl">📅</span>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-4" style="border: 1px solid #e2e8f0;">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs" style="color: #9a8b7c;">Pendientes</p>
              <p id="citasPendientes" class="text-2xl font-bold text-yellow-600 mt-1">0</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-yellow-500/20 flex items-center justify-center">
              <span class="text-xl">⏳</span>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-4" style="border: 1px solid #e2e8f0;">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs" style="color: #9a8b7c;">Confirmadas</p>
              <p id="citasConfirmadas" class="text-2xl font-bold text-blue-600 mt-1">0</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center">
              <span class="text-xl">✅</span>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-4" style="border: 1px solid #e2e8f0;">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs" style="color: #9a8b7c;">Hoy</p>
              <p id="citasHoy" class="text-2xl font-bold text-sky-600 mt-1">0</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-sky-500/20 flex items-center justify-center">
              <span class="text-xl">📍</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="bg-white rounded-2xl p-4 mb-6" style="border: 1px solid #e2e8f0;">
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-1">
            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5" style="color: #9a8b7c;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
              type="text"
              id="searchInput"
              placeholder="Buscar por mascota o cliente..."
              class="w-full pl-10 pr-4 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
              style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;"
            />
          </div>
          <select id="estadoFilter" class="px-4 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;">
            <option value="" class="bg-white">Todos los estados</option>
            <option value="pendiente" class="bg-white">Pendiente</option>
            <option value="confirmado" class="bg-white">Confirmado</option>
            <option value="en_espera" class="bg-white">En Espera</option>
            <option value="completado" class="bg-white">Completado</option>
            <option value="rechazado" class="bg-white">Rechazado</option>
          </select>
          <input type="date" id="fechaFilter" class="px-4 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" />
          <!-- Vet filter — secretaria only, shown dynamically -->
          <select id="vetFilter" class="hidden px-4 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;">
            <option value="">Todos los veterinarios</option>
          </select>
          <!-- Report button — only visible when a vet is selected -->
          <button id="reporteVetBtn" class="hidden items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold text-white transition-all" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Enviar Reporte
          </button>
        </div>
      </div>

      <!-- Waitlist Panel (secretaria) -->
      <div id="waitlistPanel" class="bg-white rounded-2xl overflow-hidden mb-6 hidden" style="border: 1px solid #e2e8f0;">
        <div class="px-4 py-3 flex items-center justify-between" style="border-bottom: 1px solid #e2e8f0; background:#fafbfc;">
          <div>
            <h3 class="text-sm font-semibold" style="color:#0f172a;">Lista de Espera</h3>
            <p class="text-xs" style="color:#94a3b8;">Pacientes candidatos para cubrir huecos por cancelaciones</p>
          </div>
          <button id="addWaitlistBtn" class="px-3 py-2 rounded-lg text-xs font-semibold text-white" style="background:linear-gradient(135deg,#2563eb,#1d4ed8);">
            Nuevo en espera
          </button>
        </div>

        <div id="waitlistLoading" class="p-4 text-xs" style="color:#94a3b8;">Cargando lista de espera...</div>
        <div id="waitlistEmpty" class="p-4 text-xs hidden" style="color:#94a3b8;">No hay pacientes en lista de espera.</div>
        <div id="waitlistTableWrap" class="hidden overflow-x-auto">
          <table class="w-full">
            <thead style="background:#f8fafc;border-bottom:1px solid #e2e8f0;">
              <tr>
                <th class="px-3 py-2 text-left text-[11px] uppercase" style="color:#9a8b7c;">Mascota / Cliente</th>
                <th class="px-3 py-2 text-left text-[11px] uppercase" style="color:#9a8b7c;">Atencion</th>
                <th class="px-3 py-2 text-left text-[11px] uppercase" style="color:#9a8b7c;">Prioridad</th>
                <th class="px-3 py-2 text-left text-[11px] uppercase" style="color:#9a8b7c;">Preferencia</th>
                <th class="px-3 py-2 text-left text-[11px] uppercase" style="color:#9a8b7c;">Estado</th>
                <th class="px-3 py-2 text-center text-[11px] uppercase" style="color:#9a8b7c;">Acciones</th>
              </tr>
            </thead>
            <tbody id="waitlistTableBody" class="divide-y divide-[#e2e8f0]"></tbody>
          </table>
        </div>
      </div>

      <!-- Citas Table -->
      <div class="bg-white rounded-2xl overflow-hidden" style="border: 1px solid #e2e8f0;">
        <!-- Loading State -->
        <div id="loadingState" class="p-12 text-center">
          <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-500 mx-auto"></div>
          <p class="mt-4" style="color: #9a8b7c;">Cargando citas...</p>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="p-12 text-center hidden">
          <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4" style="background: #f1f5f9;">
            <span class="text-3xl">📅</span>
          </div>
          <h3 class="text-lg font-medium" style="color: #0f172a;">No hay citas programadas</h3>
          <p class="mt-2" style="color: #9a8b7c;">Haz clic en "Nueva Cita" para agendar una</p>
        </div>

        <!-- Table -->
        <div id="tableContainer" class="hidden overflow-x-auto">
          <table class="w-full">
            <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Fecha/Hora</th>
                <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Mascota</th>
                <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Cliente</th>
                <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Tipo Atención</th>
                <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Costo</th>
                <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Estado</th>
                <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Acciones</th>
              </tr>
            </thead>
            <tbody id="citasTableBody" class="divide-y divide-[#e2e8f0]"></tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div id="paginationContainer" class="hidden px-4 py-3" style="border-top: 1px solid #e2e8f0;">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="text-sm" style="color: #9a8b7c;">
            Mostrando <span class="showingFromSync">1</span> a <span class="showingToSync">10</span> de <span class="totalItemsSync">0</span> citas
          </div>
          <div class="flex items-center space-x-2">
            <button class="prevPageSync px-3 py-1.5 rounded-lg hover:bg-black/5 disabled:opacity-50 disabled:cursor-not-allowed" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            <span class="text-sm px-3" style="color: #0f172a;"><span class="currentPageSync">1</span> / <span class="totalPagesSync">1</span></span>
            <button class="nextPageSync px-3 py-1.5 rounded-lg hover:bg-black/5 disabled:opacity-50 disabled:cursor-not-allowed" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
          </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Create/Edit Modal -->
    <div id="modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50">
      <div class="bg-white rounded-2xl w-full max-w-2xl mx-4 shadow-2xl max-h-[90vh] flex flex-col" style="border: 1px solid #e2e8f0;">
        <div class="p-4 flex justify-between items-center flex-shrink-0" style="border-bottom: 1px solid #e2e8f0;">
          <h3 id="modalTitle" class="text-lg font-semibold" style="color: #0f172a;">Nueva Cita</h3>
          <button id="closeModal" class="p-1 hover:bg-black/5 rounded-lg transition-colors" style="color: #9a8b7c;">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        <form id="citaForm" class="p-5 space-y-4 flex-1 overflow-y-auto">
          <input type="hidden" id="citaId" value="" />

          <!-- Step 1: Cliente Selection -->
          <div>
            <label class="block text-sm font-medium mb-2" style="color: #475569;">1. Seleccionar Cliente *</label>
            <div class="flex gap-2 mb-2">
              <select id="clienteSearchType" class="px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;">
                <option value="nombre" class="bg-white">Por Nombre</option>
                <option value="telefono" class="bg-white">Por Telefono</option>
                <option value="id" class="bg-white">Por ID</option>
              </select>
              <div class="relative flex-1">
                <input
                  type="text"
                  id="clienteSearch"
                  placeholder="Escribe para buscar..."
                  class="w-full px-4 py-2 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;"
                  autocomplete="off"
                />
                <input type="hidden" id="clienteIdCita" name="cliente_id" />
                <div id="clienteDropdown" class="absolute z-50 top-full left-0 right-0 mt-1 bg-white rounded-lg max-h-48 overflow-y-auto hidden shadow-xl" style="border: 1px solid #e2e8f0;"></div>
              </div>
            </div>
          </div>

          <!-- Selected Cliente Info -->
          <div id="selectedClienteInfo" class="hidden rounded-lg p-4" style="background: rgba(13, 148, 136, 0.08); border: 1px solid rgba(13, 148, 136, 0.2);">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center">
                  <svg class="w-5 h-5" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                </div>
                <div>
                  <p id="clienteNombreSelected" class="font-medium" style="color: #0f172a;"></p>
                  <p id="clienteContacto" class="text-sm" style="color: #9a8b7c;"></p>
                </div>
              </div>
              <button type="button" id="clearCliente" class="p-1" style="color: #9a8b7c;">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>
          </div>

          <!-- Step 2: Mascota Selection -->
          <div id="mascotaSection" class="hidden">
            <label class="block text-sm font-medium mb-2" style="color: #475569;">2. Seleccionar Mascota del Cliente *</label>
            <div class="flex gap-2 mb-2">
              <select id="mascotaSearchType" class="px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;">
                <option value="nombre" class="bg-white">Por Nombre</option>
                <option value="especie" class="bg-white">Por Especie</option>
                <option value="id" class="bg-white">Por ID</option>
              </select>
              <div class="relative flex-1">
                <input
                  type="text"
                  id="mascotaSearchInput"
                  placeholder="Filtrar mascotas..."
                  class="w-full px-4 py-2 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;"
                  autocomplete="off"
                />
              </div>
            </div>
            <select id="mascotaSelect" class="w-full px-4 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;">
              <option value="" class="bg-white">-- Selecciona una mascota --</option>
            </select>
            <input type="hidden" id="mascotaId" name="mascota_id" required />
          </div>

          <!-- Selected Mascota Info -->
          <div id="selectedMascotaInfo" class="hidden rounded-lg p-4" style="background: #f8fafc; border: 1px solid #e2e8f0;">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <div id="mascotaAvatar" class="w-12 h-12 rounded-full bg-amber-500/20 flex items-center justify-center">
                  <span class="text-2xl">🐕</span>
                </div>
                <div>
                  <p id="mascotaNombre" class="font-medium" style="color: #0f172a;"></p>
                  <p id="mascotaDetalles" class="text-sm" style="color: #9a8b7c;"></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Fecha + Duración -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium mb-2" style="color: #475569;">Fecha *</label>
              <input
                type="date"
                id="fechaCita"
                name="fecha"
                required
                class="w-full px-4 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2" style="color: #475569;">Duración</label>
              <div class="flex items-center gap-2">
                <div class="flex-1">
                  <input
                    type="number"
                    id="duracionHoras"
                    value="1"
                    min="0"
                    max="8"
                    step="1"
                    list="listaHoras"
                    placeholder="0"
                    class="w-full px-3 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;"
                  />
                  <datalist id="listaHoras">
                    <option value="0"></option>
                    <option value="1"></option>
                    <option value="2"></option>
                    <option value="3"></option>
                    <option value="4"></option>
                    <option value="5"></option>
                    <option value="6"></option>
                    <option value="7"></option>
                    <option value="8"></option>
                  </datalist>
                  <p class="text-xs mt-1 text-center" style="color: #94a3b8;">horas</p>
                </div>
                <span class="font-bold text-lg mb-4" style="color: #9a8b7c;">:</span>
                <div class="flex-1">
                  <input
                    type="number"
                    id="duracionMinutos"
                    value="0"
                    min="0"
                    max="45"
                    step="15"
                    list="listaMinutos"
                    placeholder="0"
                    class="w-full px-3 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;"
                  />
                  <datalist id="listaMinutos">
                    <option value="0"></option>
                    <option value="15"></option>
                    <option value="30"></option>
                    <option value="45"></option>
                  </datalist>
                  <p class="text-xs mt-1 text-center" style="color: #94a3b8;">minutos</p>
                </div>
              </div>
              <p id="duracionTotal" class="text-xs mt-2 text-center font-medium" style="color: #3b82f6;">= 1 hora</p>
            </div>
          </div>

          <!-- Hora (hidden) + Time Grid -->
          <div>
            <input type="hidden" id="horaCita" name="hora" />
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <label class="block text-sm font-medium" style="color: #475569;">
                  Hora *
                  <span id="selectedTimeDisplay" class="ml-2 font-semibold hidden" style="color: #3b82f6;"></span>
                </label>
                <button
                  type="button"
                  id="toggleTimeGrid"
                  title="Mostrar u ocultar horarios disponibles"
                  class="p-1 rounded-md hover:bg-black/5 transition-colors" style="color: #9a8b7c;"
                >
                  <svg id="toggleTimeGridIcon" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
              </div>
              <div class="flex items-center gap-3 text-xs" style="color: #94a3b8;">
                <span class="flex items-center gap-1">
                  <span class="w-3 h-3 rounded inline-block" style="background: #f8fafc; border: 1px solid #e2e8f0;"></span> Libre
                </span>
                <span class="flex items-center gap-1">
                  <span class="w-3 h-3 rounded bg-red-500/30 border border-red-500/40 inline-block"></span> Ocupado
                </span>
                <span class="flex items-center gap-1">
                  <span class="w-3 h-3 rounded bg-amber-500/20 border border-amber-500/30 inline-block"></span> Conflicto
                </span>
                <span class="flex items-center gap-1">
                  <span class="w-3 h-3 rounded bg-blue-500 inline-block"></span> Inicio
                </span>
                <span class="flex items-center gap-1">
                  <span class="w-3 h-3 rounded bg-blue-500/25 border border-blue-500/40 inline-block"></span> Rango
                </span>
                <span class="flex items-center gap-1">
