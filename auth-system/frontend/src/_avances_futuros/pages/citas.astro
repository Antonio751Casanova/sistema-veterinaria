    selectCliente(cliente);
    mascotaIdInput.value = String(item.mascota_id);
    mascotaSelect.value = String(item.mascota_id);
    mascotaSelect.dispatchEvent(new Event('change'));

    tipoAtencion.value = item.tipo_atencion;
    setDuracion(item.duracion_minutos || 60);
    if (item.preferencia_veterinario_id) {
      veterinarioAsignado.value = String(item.preferencia_veterinario_id);
    }

    if (!Number.isNaN(prefillReferenceCitaId) && prefillReferenceCitaId > 0) {
      const citaRef = citas.find(c => c.id === prefillReferenceCitaId);
      if (citaRef) {
        const f = new Date(citaRef.fecha_hora);
        fechaCita.value = f.toISOString().split('T')[0];
        horaCita.value = f.toTimeString().slice(0, 5);
