<style>
  :global(body) {
    background: #f1f5f9 !important;
  }

  :global(.cita-row-focus) {
    animation: citaRowPulse 1.8s ease;
    background: rgba(59, 130, 246, 0.12) !important;
  }

  @keyframes citaRowPulse {
    0% { box-shadow: inset 0 0 0 9999px rgba(59, 130, 246, 0.22); }
    100% { box-shadow: inset 0 0 0 9999px rgba(59, 130, 246, 0); }
  }
</style>

<script>
  import { getVetName, getUsuario, isAuthenticated, logout } from '../services/authService';
  import { listarCitas, crearCita, actualizarCita, eliminarCita, generarMensajeWhatsApp, generarMensajeEmail, abrirWhatsApp, abrirEmail, type CitaConDetalles, type CitaCreate, type CitaUpdate } from '../services/citaService';
  import { listarMascotas, type Mascota } from '../services/mascotaService';
  import { listarClientes, type Cliente } from '../services/clienteService';
  import { listarVeterinarios, type UsuarioData } from '../services/usuarioService';
  import { listarListaEspera, obtenerItemListaEspera, crearItemListaEspera, actualizarItemListaEspera, eliminarItemListaEspera, type ListaEsperaItem, type ListaEsperaCreate } from '../services/listaEsperaService';

  // Check auth
  if (!isAuthenticated()) {
    window.location.href = '/';
  }

  const usuarios = getUsuario();
  const userRol = usuarios?.rol ?? 'secretaria';
  const queryParams = new URLSearchParams(window.location.search);
  const initialSearchQuery = (queryParams.get('buscar') || '').trim();
  const prefillWaitlistId = parseInt(queryParams.get('waitlistId') || '', 10);
  const prefillReferenceCitaId = parseInt(queryParams.get('refCitaId') || queryParams.get('citaId') || '', 10);
  let pendingFocusCitaId: number | null = null;
  const queryCitaId = parseInt(queryParams.get('citaId') || '', 10);
  if (!Number.isNaN(queryCitaId) && queryCitaId > 0) {
    pendingFocusCitaId = queryCitaId;
  }

