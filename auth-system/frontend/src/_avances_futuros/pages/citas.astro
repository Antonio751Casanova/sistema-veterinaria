    totalCitasEl.textContent = citas.length.toString();
    citasPendientesEl.textContent = citas.filter(c => c.estado === 'pendiente').length.toString();
    citasConfirmadasEl.textContent = citas.filter(c => c.estado === 'confirmado').length.toString();
    citasHoyEl.textContent = citas.filter(c => {
      const fecha = new Date(c.fecha_hora);
      return fecha >= today && fecha < tomorrow;
    }).length.toString();
  }

