  function normalizePhone(value: string | null | undefined): string {
    return (value || '').replace(/\D/g, '');
  }

  function toDateKey(date: Date): string {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }

  function getTodayKey(): string {
    return toDateKey(new Date());
  }

  function pickBestCita(citas: CitaConDetalles[]): CitaConDetalles | null {
    return citas[0] || null;
  }

  function getCitasForCliente(_nombreCliente: string, _telefonoCliente?: string): CitaConDetalles[] {
    return [];
  }

  // En Avance 1 la búsqueda redirige a Clientes / Mascotas (no a /citas).
  // TODO: En Avance 2 restaurar redirección a /citas?citaId=...
  function buildClientCitaTarget(_nombreCliente: string, _telefonoCliente?: string): string {
    return '/clientes';
  }

  function buildMascotaCitaTarget(_mascotaId: number, _fallbackText: string): string {
    return '/mascotas';
  }

  loadData();

  // ==========================================
  // OMNISEARCH — Functional search
  // ==========================================
  const omnisearchInput = document.getElementById('omnisearchInput') as HTMLInputElement | null;
  const searchDropdown = document.getElementById('searchDropdown') as HTMLDivElement;
  let searchTimeout: ReturnType<typeof setTimeout>;

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); omnisearchInput?.focus(); }
    if (e.key === 'Escape') { omnisearchInput?.blur(); searchDropdown.classList.add('hidden'); }
  });

  function positionDropdown() {
    if (!omnisearchInput) return;
    const rect = omnisearchInput.getBoundingClientRect();
    searchDropdown.style.top = `${rect.bottom + 6}px`;
    searchDropdown.style.left = `${rect.left}px`;
    searchDropdown.style.width = `${rect.width}px`;
  }

  function performSearch(query: string) {
    if (!query || query.length < 2) { searchDropdown.classList.add('hidden'); return; }

    const q = query.toLowerCase();
    const qPhone = normalizePhone(query);
    const results: Array<{
      type: 'cita' | 'cliente' | 'mascota';
      petName: string;
      ownerName: string;
      phone: string;
      reason: string;
      dateLabel: string;
      timeLabel: string;
      status: string;
      statusLabel: string;
      emoji: string;
      bg: string;
      targetUrl: string;
    }> = [];

    // Search citas (by client name, pet name, phone)
    for (const c of allCitas) {
      const phoneMatch = qPhone.length >= 3 && normalizePhone(c.telefono_cliente).includes(qPhone);
      if (c.nombre_cliente.toLowerCase().includes(q) || c.nombre_mascota.toLowerCase().includes(q) || phoneMatch) {
        const hora = new Date(c.fecha_hora).toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit' });
        const fecha = new Date(c.fecha_hora).toLocaleDateString('es-MX', { day:'2-digit', month:'short' });
        results.push({
          type: 'cita',
          petName: c.nombre_mascota,
          ownerName: c.nombre_cliente,
          phone: c.telefono_cliente || 'N/A',
          reason: c.tipo_atencion,
          dateLabel: fecha,
          timeLabel: hora,
          status: c.estado,
          statusLabel: c.estado,
          emoji: speciesEmoji[c.especie_mascota] || '🐾',
          bg: speciesAvatarBg[c.especie_mascota] || 'background:#f1f5f9;',
          targetUrl: `/citas?citaId=${c.id}`
        });
      }
      if (results.length >= 10) break;
    }

    // Search clients not in citas
    if (results.length < 10) {
      for (const cl of allClientes) {
        const phoneMatch = qPhone.length >= 3 && normalizePhone(cl.telefono).includes(qPhone);
        if (cl.nombre.toLowerCase().includes(q) || phoneMatch) {
          if (!results.find(r => r.type === 'cliente' && r.ownerName === cl.nombre)) {
            const citasCliente = getCitasForCliente(cl.nombre, cl.telefono).sort((a, b) =>
              new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime()
            );
            const best = pickBestCita(citasCliente);
            const bestDate = best ? new Date(best.fecha_hora) : null;
            results.push({
              type: 'cliente',
              petName: best?.nombre_mascota || 'Cliente',
              ownerName: cl.nombre,
              phone: cl.telefono || 'N/A',
              reason: best?.tipo_atencion || `${cl.total_mascotas} mascota(s) registradas`,
              dateLabel: bestDate ? bestDate.toLocaleDateString('es-MX', { day: '2-digit', month: 'short' }) : '--',
              timeLabel: bestDate ? bestDate.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) : 'Cliente',
              status: best?.estado || 'completado',
              statusLabel: best?.estado || 'cliente',
              emoji: '👤',
              bg: 'background:#eff6ff;',
              targetUrl: buildClientCitaTarget(cl.nombre, cl.telefono)
            });
          }
        }
        if (results.length >= 10) break;
      }
    }

    // Search pets not in citas
    if (results.length < 10) {
      for (const m of allMascotas) {
        const ownerPhoneMatch = qPhone.length >= 3 && normalizePhone(m.telefono_dueno).includes(qPhone);
        if (m.nombre.toLowerCase().includes(q) || (m.nombre_dueno && m.nombre_dueno.toLowerCase().includes(q)) || ownerPhoneMatch) {
          if (!results.find(r => r.type === 'mascota' && r.petName === m.nombre && r.ownerName === m.nombre_dueno)) {
            const citasMascota = allCitas
              .filter(c => c.mascota_id === m.id)
              .sort((a, b) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime());
            const best = pickBestCita(citasMascota);
            const bestDate = best ? new Date(best.fecha_hora) : null;
            results.push({
              type: 'mascota',
              petName: m.nombre,
              ownerName: m.nombre_dueno,
              phone: m.telefono_dueno || 'N/A',
              reason: best?.tipo_atencion || `${m.especie}${m.raza ? ' · ' + m.raza : ''}`,
              dateLabel: bestDate ? bestDate.toLocaleDateString('es-MX', { day: '2-digit', month: 'short' }) : '--',
              timeLabel: bestDate ? bestDate.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) : 'Mascota',
              status: best?.estado || 'completado',
              statusLabel: best?.estado || 'mascota',
              emoji: speciesEmoji[m.especie] || '🐾',
              bg: speciesAvatarBg[m.especie] || 'background:#f1f5f9;',
              targetUrl: buildMascotaCitaTarget(m.id, `${m.nombre} ${m.nombre_dueno}`)
            });
          }
        }
        if (results.length >= 10) break;
      }
    }

    if (results.length === 0) {
      searchDropdown.innerHTML = '<div class="search-no-results">No se encontraron resultados</div>';
    } else {
      searchDropdown.innerHTML = results.map(r => `
        <div class="search-result-item" onclick="window.location.href='${r.targetUrl}'">
          <div class="search-result-left">
            <div class="search-avatar" style="${r.bg}">
              <span>${r.emoji}</span>
            </div>
            <div class="search-result-info">
              <div class="search-title-row">
                <p class="search-pet-name">${r.petName}</p>
                <span class="search-title-separator">|</span>
                <p class="search-owner-name">${r.ownerName}</p>
              </div>
              <div class="search-meta-row">
                <span class="search-meta-chip">
                  <span class="search-meta-icon">📞</span>
                  <span>${r.phone}</span>
                </span>
                <span class="search-meta-chip" title="${r.reason}">
                  <span class="search-meta-icon">🩺</span>
                  <span>${r.reason}</span>
                </span>
              </div>
            </div>
          </div>
          <div class="search-result-right">
            <div class="search-right-meta">
              <p class="search-date-label">${r.dateLabel}</p>
              <p class="search-time-label">${r.timeLabel}</p>
              <span class="search-status-badge ${r.status}">${r.statusLabel}</span>
            </div>
            <button
              type="button"
              class="search-detail-btn"
              onclick="event.stopPropagation(); window.location.href='${r.targetUrl}'"
              aria-label="Ver detalles de ${r.petName}"
            >
              <span class="search-detail-eye">👁</span>
              <span>Ver detalles</span>
            </button>
          </div>
        </div>
      `).join('');
    }

    positionDropdown();
    searchDropdown.classList.remove('hidden');
  }

  omnisearchInput?.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => performSearch(omnisearchInput.value.trim()), 300);
  });

  omnisearchInput?.addEventListener('focus', () => {
    if (omnisearchInput.value.trim().length >= 2) performSearch(omnisearchInput.value.trim());
  });

  document.addEventListener('click', (e) => {
    if (!searchDropdown.contains(e.target as Node) && e.target !== omnisearchInput) searchDropdown.classList.add('hidden');
  });

  // ==========================================
  // CALENDAR POPUP
  // ==========================================
  let calendarCurrentMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
  let calendarSelectedDateKey: string | null = null;

  function getMonthLabel(date: Date): string {
    return date.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });
  }

  function getDayCitas(dateKey: string): CitaConDetalles[] {
    return allCitas
      .filter(c => toDateKey(new Date(c.fecha_hora)) === dateKey)
      .sort((a, b) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime());
  }

  function renderCalendarDayList() {
    if (!calendarSelectedDateKey) {
      calendarDayTitle.textContent = 'Selecciona un dia';
      calendarDayCount.textContent = '0 citas';
      calendarDayList.innerHTML = '<div class="px-4 py-6 text-center text-xs" style="color:#94a3b8;">Haz clic en un dia del calendario para ver las citas</div>';
      return;
    }

    const selectedDate = new Date(`${calendarSelectedDateKey}T12:00:00`);
    calendarDayTitle.textContent = selectedDate.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

    const term = calendarDaySearchInput.value.trim().toLowerCase();
    const termPhone = normalizePhone(calendarDaySearchInput.value);
    let citasDia = getDayCitas(calendarSelectedDateKey);

    if (term) {
      citasDia = citasDia.filter(c => {
        const byName = c.nombre_cliente.toLowerCase().includes(term) || c.nombre_mascota.toLowerCase().includes(term);
        const byPhone = termPhone.length >= 3 && normalizePhone(c.telefono_cliente).includes(termPhone);
        return byName || byPhone;
      });
    }

    calendarDayCount.textContent = `${citasDia.length} cita(s)`;

    if (!citasDia.length) {
      calendarDayList.innerHTML = '<div class="px-4 py-6 text-center text-xs" style="color:#94a3b8;">No hay citas para ese filtro</div>';
      return;
    }

    calendarDayList.innerHTML = citasDia.map(c => {
      const hora = new Date(c.fecha_hora).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
      const statusClass = c.estado.replace(/\s+/g, '_');
      return `
        <div class="calendar-day-item" onclick="window.location.href='/citas?citaId=${c.id}'">
          <div class="calendar-day-item-row">
            <p class="calendar-day-time">${hora}</p>
            <div class="calendar-day-main">
              <p class="calendar-day-pet-owner">
                <span class="calendar-day-pet">${c.nombre_mascota}</span>
                <span class="calendar-day-owner"> · ${c.nombre_cliente}</span>
              </p>
              <p class="calendar-day-service">${c.tipo_atencion}</p>
            </div>
            <span class="calendar-day-status ${statusClass}">${c.estado}</span>
          </div>
        </div>
      `;
    }).join('');
  }

  function renderCalendarGrid() {
    const monthStart = new Date(calendarCurrentMonth.getFullYear(), calendarCurrentMonth.getMonth(), 1);
    const monthEnd = new Date(calendarCurrentMonth.getFullYear(), calendarCurrentMonth.getMonth() + 1, 0);
    const firstWeekday = (monthStart.getDay() + 6) % 7;
    const daysInMonth = monthEnd.getDate();

    const citasByDay = new Map<string, number>();
    allCitas.forEach(c => {
      const d = new Date(c.fecha_hora);
      if (d.getMonth() === calendarCurrentMonth.getMonth() && d.getFullYear() === calendarCurrentMonth.getFullYear()) {
        const key = toDateKey(d);
        citasByDay.set(key, (citasByDay.get(key) || 0) + 1);
      }
    });

    calendarMonthLabel.textContent = getMonthLabel(calendarCurrentMonth);
    const totalMes = Array.from(citasByDay.values()).reduce((acc, n) => acc + n, 0);
    calendarSummaryText.textContent = `${totalMes} cita(s) en ${getMonthLabel(calendarCurrentMonth)}`;

    const cells: string[] = [];
    for (let i = 0; i < firstWeekday; i++) {
      cells.push('<div class="calendar-day-empty" aria-hidden="true"></div>');
    }

    const todayKey = getTodayKey();
    for (let day = 1; day <= daysInMonth; day++) {
      const key = toDateKey(new Date(calendarCurrentMonth.getFullYear(), calendarCurrentMonth.getMonth(), day));
      const count = citasByDay.get(key) || 0;
      const isSelected = calendarSelectedDateKey === key;
      const isToday = key === todayKey;
      cells.push(`
        <button class="calendar-day-btn ${count ? 'has-citas' : ''} ${isSelected ? 'selected' : ''}" data-date-key="${key}" title="${count ? `${count} cita(s)` : 'Sin citas'}">
          <span class="calendar-day-number-wrap">
            <span class="calendar-day-number ${isSelected ? 'selected' : ''}">${day}</span>
            ${isToday ? '<span class="calendar-today-dot"></span>' : ''}
          </span>
          ${count ? `<span class="calendar-day-count-badge">${count}</span>` : ''}
        </button>
      `);
    }

    calendarGrid.innerHTML = cells.join('');

    calendarGrid.querySelectorAll<HTMLButtonElement>('.calendar-day-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        calendarSelectedDateKey = btn.dataset.dateKey || null;
        renderCalendarGrid();
        renderCalendarDayList();
      });
    });
  }

  function openCalendarPopup() {
    renderCalendarGrid();
    renderCalendarDayList();
    if (calendarOverlay) calendarOverlay.dataset.open = 'true';
  }

  function closeCalendarFn() {
    if (calendarOverlay) calendarOverlay.dataset.open = 'false';
  }

  calendarPopupBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (calendarOverlay && calendarOverlay.dataset.open === 'true') {
      closeCalendarFn();
      return;
    }
    openCalendarPopup();
  });

  closeCalendarPopup?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    closeCalendarFn();
  });

  calendarOverlay?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    closeCalendarFn();
  });

  calendarPopupPanel?.addEventListener('click', (e) => {
    e.stopPropagation();
  });

  calendarPrevMonth?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    calendarCurrentMonth = new Date(calendarCurrentMonth.getFullYear(), calendarCurrentMonth.getMonth() - 1, 1);
    renderCalendarGrid();
    renderCalendarDayList();
  });

  calendarNextMonth?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    calendarCurrentMonth = new Date(calendarCurrentMonth.getFullYear(), calendarCurrentMonth.getMonth() + 1, 1);
    renderCalendarGrid();
    renderCalendarDayList();
  });

  calendarDaySearchInput?.addEventListener('input', renderCalendarDayList);

  // Calendar close is handled by overlay and close button.

  // ==========================================
  // TO-DO LIST
  // ==========================================
  interface TodoItem { id: number; text: string; status: 'pending' | 'completed' | 'cancelled'; createdAt: string; }

  const TODO_KEY = 'vetpets_todo_list';
  const todoListEl = document.getElementById('todoList') as HTMLDivElement;
  const todoNewInput = document.getElementById('todoNewInput') as HTMLInputElement;
  const todoAddBtn = document.getElementById('todoAddBtn') as HTMLButtonElement;
  const todoCountBadge = document.getElementById('todoCountBadge') as HTMLSpanElement;
  const todoPopupCount = document.getElementById('todoPopupCount') as HTMLSpanElement;
  const todoSearchInput = document.getElementById('todoSearchInput') as HTMLInputElement;
  const tasksPopupBtn = document.getElementById('tasksPopupBtn') as HTMLButtonElement;
  const tasksPopupPanel = document.getElementById('tasksPopupPanel') as HTMLDivElement;
  const closeTasksPopup = document.getElementById('closeTasksPopup') as HTMLButtonElement;
  let currentTodoFilter = 'all';

  // Filter tabs
  document.querySelectorAll('.todo-filter-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.todo-filter-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentTodoFilter = (tab as HTMLElement).dataset.filter || 'all';
      renderTodos(todoSearchInput?.value || '');
    });
  });

  // Tasks popup toggle
  tasksPopupBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    tasksPopupPanel.classList.toggle('hidden');
    if (!tasksPopupPanel.classList.contains('hidden')) {
      todoNewInput?.focus();
    }
  });
  closeTasksPopup?.addEventListener('click', () => {
    tasksPopupPanel.classList.add('hidden');
  });
  document.addEventListener('click', (e) => {
    if (_blockPopupClose) return;
    if (tasksPopupPanel && !tasksPopupPanel.contains(e.target as Node) && e.target !== tasksPopupBtn && !tasksPopupBtn.contains(e.target as Node)) {
      tasksPopupPanel.classList.add('hidden');
    }
  });

  // Flag to prevent popup from closing during modal/actions
  let _blockPopupClose = false;

  function formatTodoDate(dateStr: string): string {
    const d = new Date(dateStr);
    return d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short' }) + ' ' + d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
  }

  function loadTodos(): TodoItem[] {
    try {
      const raw = localStorage.getItem(TODO_KEY);
      if (raw) {
        const items = JSON.parse(raw) as any[];
        let needsSave = false;
        for (const item of items) {
          if (!item.createdAt) {
            item.createdAt = new Date().toISOString();
            needsSave = true;
          }
          // Migrate old boolean completed to status string
          if (item.status === undefined) {
            item.status = item.completed ? 'completed' : 'pending';
            delete item.completed;
            needsSave = true;
          }
        }
        if (needsSave) saveTodos(items);
        return items;
      }
    } catch {}
    const now = new Date().toISOString();
    const defaults: TodoItem[] = [
      { id: 1, text: 'Llamar al proveedor de croquetas', status: 'completed', createdAt: now },
      { id: 2, text: 'Revisar inventario de vacunas', status: 'completed', createdAt: now },
      { id: 3, text: 'Confirmar citas del lunes', status: 'completed', createdAt: now },
      { id: 4, text: 'Limpiar área de gatos', status: 'pending', createdAt: now },
      { id: 5, text: 'Actualizar precios en sistema', status: 'pending', createdAt: now },
    ];
    saveTodos(defaults);
    return defaults;
  }

  function saveTodos(todos: TodoItem[]) { localStorage.setItem(TODO_KEY, JSON.stringify(todos)); }

  const statusLabels: Record<string, string> = { pending: 'Pendiente', completed: 'Completada', cancelled: 'Cancelada' };

  function renderTodos(filter = '') {
    const todos = loadTodos();
    const pendingCount = todos.filter(t => t.status === 'pending').length;
    todoCountBadge.textContent = pendingCount.toString();
    if (todoPopupCount) todoPopupCount.textContent = pendingCount.toString();

    let filtered = filter ? todos.filter(t => t.text.toLowerCase().includes(filter.toLowerCase())) : [...todos];

    // Apply tab filter
    if (currentTodoFilter !== 'all') {
      filtered = filtered.filter(t => t.status === currentTodoFilter);
    }

    if (filtered.length === 0) {
      const emptyMessages: Record<string, string> = {
        all: 'No hay tareas',
        pending: 'No hay tareas pendientes',
        completed: 'No hay tareas completadas',
        cancelled: 'No hay tareas canceladas',
      };
      todoListEl.innerHTML = `
        <div class="px-5 py-8 text-center">
          <div style="width:48px;height:48px;border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;background:#f1f5f9;">
            <svg style="width:24px;height:24px;color:#cbd5e1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
          </div>
          <p style="font-size:12px;font-weight:500;color:#94a3b8;">${filter ? 'No se encontraron tareas' : emptyMessages[currentTodoFilter] || emptyMessages.all}</p>
          <p style="font-size:10px;margin-top:2px;color:#cbd5e1;">${filter ? 'Intenta con otro término' : (currentTodoFilter === 'all' || currentTodoFilter === 'pending' ? 'Agrega una nueva tarea abajo' : '')}</p>
        </div>`;
      return;
    }

    // Sort: pending first, then completed, then cancelled
    const statusOrder: Record<string, number> = { pending: 0, completed: 1, cancelled: 2 };
    const sorted = [...filtered].sort((a, b) => {
      const oa = statusOrder[a.status] ?? 1;
      const ob = statusOrder[b.status] ?? 1;
      if (oa !== ob) return oa - ob;
      return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
    });

    todoListEl.innerHTML = sorted.map(t => {
      const isCompleted = t.status === 'completed';
      const isCancelled = t.status === 'cancelled';
      const isPending = t.status === 'pending';
      const textClass = isCompleted ? 'completed' : isCancelled ? 'cancelled' : '';

      let actions = '';
      if (isPending) {
        actions = `
          <button class="todo-action-btn edit-btn" onclick="editTodo(${t.id})" title="Editar tarea">
            <svg style="width:14px;height:14px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
          </button>
          <button class="todo-action-btn cancel-btn" onclick="cancelTodo(${t.id})" title="Cancelar tarea">
            <svg style="width:14px;height:14px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
          </button>
          <button class="todo-action-btn delete-btn" onclick="deleteTodo(${t.id})" title="Eliminar tarea">
            <svg style="width:14px;height:14px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>`;
      } else {
        actions = `
          <button class="todo-action-btn restore-btn" onclick="restoreTodo(${t.id})" title="Restaurar a pendiente">
            <svg style="width:14px;height:14px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          </button>
          <button class="todo-action-btn delete-btn" onclick="deleteTodo(${t.id})" title="Eliminar tarea">
            <svg style="width:14px;height:14px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>`;
      }

      return `
      <div class="todo-item" data-todo-id="${t.id}">
        <input type="checkbox" class="todo-cb ${isCancelled ? 'cancelled' : ''}" ${isCompleted ? 'checked' : ''} ${isCancelled ? 'disabled' : ''} onchange="toggleTodo(${t.id})" title="${isPending ? 'Marcar como completada' : isCompleted ? 'Desmarcar' : 'Cancelada'}" />
        <div class="todo-content">
          <div class="todo-text ${textClass}${t.text.length > 100 ? ' truncated' : ''}" data-full-text>${t.text}</div>
          ${t.text.length > 100 ? '<button class="todo-expand-btn" onclick="toggleExpandTodo(this)">Ver más ▾</button>' : ''}
          <div class="todo-meta">
            <span class="todo-status-badge ${t.status}">${statusLabels[t.status]}</span>
            <span class="todo-date">
              <svg style="width:10px;height:10px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              ${t.createdAt ? formatTodoDate(t.createdAt) : ''}
            </span>
          </div>
        </div>
        <div class="todo-actions">
          ${actions}
        </div>
      </div>`;
    }).join('');
  }

  (window as any).toggleTodo = (id: number) => {
    const todos = loadTodos();
    const t = todos.find(t => t.id === id);
    if (t) {
      t.status = t.status === 'completed' ? 'pending' : 'completed';
      saveTodos(todos);
      renderTodos(todoSearchInput?.value || '');
    }
  };

  (window as any).cancelTodo = (id: number) => {
    const todos = loadTodos();
    const t = todos.find(t => t.id === id);
    if (t) {
      t.status = 'cancelled';
      saveTodos(todos);
      renderTodos(todoSearchInput?.value || '');
    }
  };

  (window as any).restoreTodo = (id: number) => {
    const todos = loadTodos();
    const t = todos.find(t => t.id === id);
    if (t) {
      t.status = 'pending';
      saveTodos(todos);
      renderTodos(todoSearchInput?.value || '');
    }
  };

  // Custom confirm modal
  function showConfirmModal(message: string, title = 'Eliminar tarea'): Promise<boolean> {
    return new Promise(resolve => {
      _blockPopupClose = true;
      const overlay = document.getElementById('confirmModal') as HTMLDivElement;
      const msgEl = document.getElementById('confirmModalMsg') as HTMLParagraphElement;
      const titleEl = overlay.querySelector('.confirm-modal-title') as HTMLElement;
      const cancelBtn = document.getElementById('confirmModalCancel') as HTMLButtonElement;
      const okBtn = document.getElementById('confirmModalOk') as HTMLButtonElement;

      titleEl.textContent = title;
      msgEl.textContent = message;
      overlay.classList.remove('hidden');

      const cleanup = (result: boolean) => {
        overlay.classList.add('hidden');
        cancelBtn.removeEventListener('click', onCancel);
        okBtn.removeEventListener('click', onOk);
        overlay.removeEventListener('click', onOverlayClick);
        setTimeout(() => { _blockPopupClose = false; }, 50);
        resolve(result);
      };

      const onCancel = () => cleanup(false);
      const onOk = () => cleanup(true);
      const onOverlayClick = (e: Event) => { if (e.target === overlay) cleanup(false); };

      cancelBtn.addEventListener('click', onCancel);
      okBtn.addEventListener('click', onOk);
      overlay.addEventListener('click', onOverlayClick);
    });
  }

  (window as any).deleteTodo = async (id: number) => {
    const confirmed = await showConfirmModal('¿Estás seguro de que deseas eliminar esta tarea? Esta acción no se puede deshacer.', 'Eliminar tarea');
    if (!confirmed) return;
    saveTodos(loadTodos().filter(t => t.id !== id));
    renderTodos(todoSearchInput?.value || '');
  };

  (window as any).editTodo = (id: number) => {
    const todos = loadTodos();
    const t = todos.find(t => t.id === id);
    if (!t || t.status !== 'pending') return;
    const item = document.querySelector(`[data-todo-id="${id}"]`) as HTMLDivElement;
    if (!item) return;
    const contentEl = item.querySelector('.todo-content') as HTMLDivElement;
    const actionsEl = item.querySelector('.todo-actions') as HTMLDivElement;
    if (!contentEl) return;

    const originalText = t.text;
    contentEl.innerHTML = `<input type="text" class="todo-edit-input" value="${originalText.replace(/"/g, '&quot;')}" />`;
    if (actionsEl) actionsEl.style.display = 'none';
    const input = contentEl.querySelector('.todo-edit-input') as HTMLInputElement;
    input.focus();
    input.select();

    const saveEdit = () => {
      const newText = input.value.trim();
      if (newText && newText !== originalText) {
        t.text = newText;
        saveTodos(todos);
      }
      renderTodos(todoSearchInput?.value || '');
    };

    input.addEventListener('blur', saveEdit);
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
      if (e.key === 'Escape') { input.value = originalText; input.blur(); }
    });
  };

  (window as any).toggleExpandTodo = (btn: HTMLButtonElement) => {
    const textEl = btn.previousElementSibling as HTMLElement;
    if (!textEl) return;
    const isExpanded = textEl.classList.contains('expanded');
    textEl.classList.toggle('truncated', isExpanded);
    textEl.classList.toggle('expanded', !isExpanded);
    btn.textContent = isExpanded ? 'Ver más ▾' : 'Ver menos ▴';
  };

  function addTodo() {
    const text = todoNewInput.value.trim();
    if (!text) return;
    const todos = loadTodos();
    todos.push({ id: todos.reduce((max, t) => Math.max(max, t.id), 0) + 1, text, status: 'pending', createdAt: new Date().toISOString() });
    saveTodos(todos);
    todoNewInput.value = '';
    // Switch to "all" or "pending" tab so user sees the new task
    if (currentTodoFilter !== 'all' && currentTodoFilter !== 'pending') {
      currentTodoFilter = 'all';
      document.querySelectorAll('.todo-filter-tab').forEach(t => {
        t.classList.toggle('active', (t as HTMLElement).dataset.filter === 'all');
      });
    }
    renderTodos(todoSearchInput?.value || '');
  }

  todoAddBtn?.addEventListener('click', addTodo);
  todoNewInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') addTodo(); });
  todoSearchInput?.addEventListener('input', () => renderTodos(todoSearchInput.value));

  renderTodos();
</script>
