  // ==========================================
  function renderCitasHoy(citas: CitaConDetalles[]) {
    const citasHoyLoading = document.getElementById('citasHoyLoading')!;
    const citasHoyEmpty = document.getElementById('citasHoyEmpty')!;
    const citasHoyList = document.getElementById('citasHoyList')!;
    const citasHoyCountEl = document.getElementById('citasHoyCount')!;

    const today = new Date(); today.setHours(0,0,0,0);
    const tomorrow = new Date(today); tomorrow.setDate(tomorrow.getDate()+1);
    const citasHoy = citas.filter(c => { const d = new Date(c.fecha_hora); return d >= today && d < tomorrow && c.estado !== 'rechazado'; });

    citasHoyLoading.classList.add('hidden');

    if (citasHoy.length > 0) { citasHoyCountEl.textContent = citasHoy.length.toString(); citasHoyCountEl.classList.remove('hidden'); }

    if (citasHoy.length === 0) { citasHoyEmpty.classList.remove('hidden'); return; }

    citasHoyList.classList.remove('hidden');
    citasHoyList.innerHTML = citasHoy.map(c => {
      const hora = new Date(c.fecha_hora).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
      const avatarBg = speciesAvatarBg[c.especie_mascota] || 'background:#f1f5f9;';
      const emoji = speciesEmoji[c.especie_mascota] || '🐾';
      return `
        <div class="px-5 py-3.5 flex items-center justify-between cursor-pointer transition-colors hover:bg-slate-50/80" style="border-bottom:1px solid #f1f5f9;" onclick="window.location.href='/citas'">
          <div class="flex items-center space-x-3">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0" style="${avatarBg}"><span class="text-lg">${emoji}</span></div>
            <div class="min-w-0">
              <p class="text-sm font-semibold truncate" style="color:#1e293b;">${c.nombre_mascota}</p>
              <p class="text-xs truncate" style="color:#94a3b8;">${c.nombre_cliente} · ${c.tipo_atencion}</p>
            </div>
          </div>
          <div class="text-right flex-shrink-0 ml-3">
            <p class="text-sm font-bold" style="color:#0f172a;">${hora}</p>
            <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-semibold mt-0.5" style="${estadoStyles[c.estado] || estadoStyles['pendiente']}">${c.estado}</span>
          </div>
        </div>`;
    }).join('');
