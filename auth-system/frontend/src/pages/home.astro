  :global(.todo-meta) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }
  :global(.todo-date) {
    font-size: 10px;
    color: #b0b8c4;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  :global(.todo-date svg) {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }
  :global(.todo-status-badge) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 7px;
