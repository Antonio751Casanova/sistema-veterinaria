<script>
  import { getVeterinaria, getUsuario, clearSession, isAuthenticated } from '../services/authService';
  // TODO: Activar en Avance 2 / Avance 3 (Citas, Notificaciones y Lista de espera)
  // import { listarCitas, type CitaConDetalles } from '../services/citaService';
  // import { listarNotificaciones, marcarNotificacionLeida, eliminarNotificacion, type Notificacion } from '../services/notificacionService';
  // import { convertirListaEsperaEnCita } from '../services/listaEsperaService';
  import { listarClientes, type Cliente } from '../services/clienteService';
  import { listarMascotas, type MascotaConDueno } from '../services/mascotaService';
  import { listarUsuarios } from '../services/usuarioService';

  type CitaConDetalles = any;
  type Notificacion = any;

  if (!isAuthenticated()) { window.location.href = '/'; }
  const vet = getVeterinaria();
  if (!vet) { window.location.href = '/'; }
  const usuario = getUsuario();
  const userRol = usuario?.rol ?? 'secretaria';

  // Hide secretaria-only elements for veterinarios
  if (userRol === 'veterinario') {
    document.querySelectorAll('[data-only-secretaria]').forEach(el => {
      (el as HTMLElement).style.display = 'none';
    });
  }

  // Elements
  const welcomeMessage = document.getElementById('welcomeMessage') as HTMLHeadingElement;
  const logoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement;
  const notificationBtn = document.getElementById('notificationBtn') as HTMLButtonElement;
  const notificationBadge = document.getElementById('notificationBadge') as HTMLSpanElement;
  const notificationPanel = document.getElementById('notificationPanel') as HTMLDivElement;
  const closeNotifications = document.getElementById('closeNotifications') as HTMLButtonElement;
  const notificationList = document.getElementById('notificationList') as HTMLDivElement;
  const notificationUnreadCount = document.getElementById('notificationUnreadCount') as HTMLSpanElement;
  const markAllNotificationsRead = document.getElementById('markAllNotificationsRead') as HTMLButtonElement;
  const notifFilterUnread = document.getElementById('notifFilterUnread') as HTMLButtonElement;
  const notifFilterAll = document.getElementById('notifFilterAll') as HTMLButtonElement;
  const notifSearchInput = document.getElementById('notifSearchInput') as HTMLInputElement;
  const notifDateInput = document.getElementById('notifDateInput') as HTMLInputElement;
  const notifClearFilters = document.getElementById('notifClearFilters') as HTMLButtonElement;
  const sidebar = document.getElementById('sidebar') as HTMLElement;
  const sidebarOverlay = document.getElementById('sidebarOverlay') as HTMLDivElement;
  const hamburgerBtn = document.getElementById('hamburgerBtn') as HTMLButtonElement;
  const todayDateEl = document.getElementById('todayDate') as HTMLParagraphElement;
  const bannerDateEl = document.getElementById('bannerDate') as HTMLSpanElement;
  const headerAvatar = document.getElementById('headerAvatar') as HTMLDivElement;
  const headerVetName = document.getElementById('headerVetName') as HTMLParagraphElement;
  const vetNameEl = document.getElementById('vetName') as HTMLSpanElement;
  const userAvatar = document.getElementById('userAvatar') as HTMLDivElement;
  const calendarPopupBtn = document.getElementById('calendarPopupBtn') as HTMLButtonElement;
  const calendarOverlay = document.getElementById('calendarOverlay') as HTMLDivElement;
  const calendarPopupPanel = document.getElementById('calendarPopupPanel') as HTMLDivElement;
  const closeCalendarPopup = document.getElementById('closeCalendarPopup') as HTMLButtonElement;
  const calendarMonthLabel = document.getElementById('calendarMonthLabel') as HTMLParagraphElement;
  const calendarSummaryText = document.getElementById('calendarSummaryText') as HTMLParagraphElement;
  const calendarPrevMonth = document.getElementById('calendarPrevMonth') as HTMLButtonElement;
  const calendarNextMonth = document.getElementById('calendarNextMonth') as HTMLButtonElement;
  const calendarGrid = document.getElementById('calendarGrid') as HTMLDivElement;
  const calendarDayTitle = document.getElementById('calendarDayTitle') as HTMLParagraphElement;
  const calendarDayCount = document.getElementById('calendarDayCount') as HTMLSpanElement;
  const calendarDayList = document.getElementById('calendarDayList') as HTMLDivElement;
  const calendarDaySearchInput = document.getElementById('calendarDaySearchInput') as HTMLInputElement;
  if (calendarOverlay) calendarOverlay.dataset.open = 'false';

  // Date
  const now = new Date();
  const dateStr = now.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const capitalizedDate = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
  if (todayDateEl) todayDateEl.textContent = capitalizedDate;
  if (bannerDateEl) bannerDateEl.textContent = capitalizedDate;

  // Vet name
  if (vet) {
    vetNameEl.textContent = vet.nombre;
    const displayName = usuario?.nombre || vet.nombre;
    userAvatar.textContent = displayName.charAt(0).toUpperCase();
    const greeting = userRol === 'veterinario'
      ? `¡Hola, Dr. ${usuario?.nombre || vet.nombre}! Bienvenido al panel.`
      : `¡Hola, ${vet.nombre}! Estamos listos para otro gran día.`;
    welcomeMessage.textContent = greeting;
    if (headerAvatar) headerAvatar.textContent = displayName.charAt(0).toUpperCase();
    if (headerVetName) headerVetName.textContent = vet.nombre;
  }

  // Mobile sidebar
  hamburgerBtn.addEventListener('click', () => { sidebar.classList.toggle('-translate-x-full'); sidebarOverlay.classList.toggle('hidden'); });
  sidebarOverlay.addEventListener('click', () => { sidebar.classList.add('-translate-x-full'); sidebarOverlay.classList.add('hidden'); });

  // Logout
  logoutBtn.addEventListener('click', () => { clearSession(); window.location.href = '/'; });

  // Notifications panel (TODO: Activar en Avance 2 / Avance 3)
  notificationBtn?.addEventListener('click', () => {
    notificationPanel?.classList.toggle('translate-x-full');
    if (notificationPanel && !notificationPanel.classList.contains('translate-x-full')) {
      loadNotifications();
    }
  });
  closeNotifications?.addEventListener('click', () => { notificationPanel?.classList.add('translate-x-full'); });
  let notificationItems: Notificacion[] = [];
  let notificationFilter: 'unread' | 'all' = 'unread';
  let notificationSearchTerm = '';
  let notificationDateFilter = '';
  let notificationsPollingId: ReturnType<typeof setInterval> | null = null;
  let notificationsFetchInFlight = false;
  let waitlistConversionInFlight = false;
  let convertingNotificationId: number | null = null;

  // Species helpers
  const speciesEmoji: Record<string, string> = { 'Perro': '🐕', 'Gato': '🐱', 'Ave': '🦜', 'Roedor': '🐹', 'Reptil': '🦎', 'Pez': '🐠', 'Anfibio': '🐸', 'Exotico': '🦥' };
  const speciesAvatarBg: Record<string, string> = { 'Perro': 'background:#fef3c7;', 'Gato': 'background:#ede9fe;', 'Ave': 'background:#e0f2fe;', 'Roedor': 'background:#fce7f3;', 'Reptil': 'background:#ecfccb;', 'Pez': 'background:#cffafe;', 'Anfibio': 'background:#dcfce7;', 'Exotico': 'background:#ffedd5;' };
  const estadoStyles: Record<string, string> = { 'pendiente': 'background:#fef3c7;color:#92400e;', 'confirmado': 'background:#d1fae5;color:#065f46;', 'en_espera': 'background:#dbeafe;color:#1e40af;', 'completado': 'background:#f3f4f6;color:#4b5563;', 'rechazado': 'background:#fee2e2;color:#991b1b;' };

  function timeAgo(dateStr: string): string {
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'ahora';
    if (mins < 60) return `hace ${mins} min`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `hace ${hrs}h`;
    const days = Math.floor(hrs / 24);
    if (days === 1) return 'ayer';
    return `hace ${days} días`;
  }

  // ==========================================
  // DATA CACHE for search
  // ==========================================
  let allCitas: CitaConDetalles[] = [];
  let allClientes: Cliente[] = [];
  let allMascotas: MascotaConDueno[] = [];

  // ==========================================
  // CITAS PENDIENTES
  // ==========================================
  function renderPendientes(citas: CitaConDetalles[]) {
    const pendientesLoading = document.getElementById('pendientesLoading')!;
    const pendientesEmpty = document.getElementById('pendientesEmpty')!;
    const pendientesList = document.getElementById('pendientesList')!;
    const pendientesCount = document.getElementById('pendientesCount')!;

    pendientesLoading.classList.add('hidden');
    const pending = citas.filter(c => c.estado === 'pendiente');

    if (pending.length === 0) {
      pendientesEmpty.classList.remove('hidden');
      return;
    }

    pendientesCount.textContent = pending.length.toString();
    pendientesCount.classList.remove('hidden');

    const sorted = [...pending].sort((a, b) => new Date(b.fecha_creacion).getTime() - new Date(a.fecha_creacion).getTime());

    pendientesList.classList.remove('hidden');
    pendientesList.innerHTML = sorted.map((c, i) => {
      const emoji = speciesEmoji[c.especie_mascota] || '🐾';
      const avatarBg = speciesAvatarBg[c.especie_mascota] || 'background:#f1f5f9;';
      const isLast = i === sorted.length - 1;
      const hora = new Date(c.fecha_hora).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
      const fecha = new Date(c.fecha_hora).toLocaleDateString('es-MX', { day: '2-digit', month: 'short' });
      return `
        <div class="px-5 py-3.5 flex items-center justify-between cursor-pointer transition-colors hover:bg-slate-50/80" style="${isLast ? '' : 'border-bottom:1px solid #f1f5f9;'}" onclick="window.location.href='/citas'">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="${avatarBg}">
              <span class="text-base">${emoji}</span>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold truncate" style="color:#1e293b;">${c.nombre_mascota} <span style="color:#94a3b8;font-weight:400;">— ${c.nombre_cliente}</span></p>
              <div class="flex items-center gap-2 mt-0.5">
