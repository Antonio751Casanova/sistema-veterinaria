  async function loadNotifications() {
    if (notificationsFetchInFlight) return;
    notificationsFetchInFlight = true;
    try {
      notificationItems = await listarNotificaciones();
      renderNotifications();
    } catch (error) {
      console.error('Error loading notifications:', error);
