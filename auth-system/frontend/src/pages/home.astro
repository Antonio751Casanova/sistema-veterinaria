  :global(.todo-status-badge.pending) {
    background: #fef3c7;
    color: #92400e;
  }
  :global(.todo-status-badge.completed) {
    background: #dcfce7;
    color: #166534;
  }
  :global(.todo-status-badge.cancelled) {
    background: #fee2e2;
    color: #991b1b;
  }

  /* Action buttons */
  :global(.todo-actions) {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
