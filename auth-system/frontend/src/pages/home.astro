---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Inicio - VetPets">
  <div class="min-h-screen" style="background: #f1f5f9;">

    <Sidebar />

    <!-- Main Content -->
    <div class="lg:ml-64 min-h-screen transition-[margin] duration-200" data-main-content>

      <!-- Top bar -->
      <header class="bg-white/80 backdrop-blur-xl sticky top-0 z-30" style="border-bottom: 1px solid #e2e8f0;">
        <div class="px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-4">
          <div class="flex items-center space-x-3 flex-shrink-0">
            <!-- Hamburger mobile -->
            <button id="hamburgerBtn" class="lg:hidden p-2 rounded-lg transition-colors hover:bg-slate-100" style="color: #334155;">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
            <div>
              <h1 class="text-xl md:text-2xl font-bold tracking-tight" style="color: #0f172a;">Panel de Control</h1>
              <p class="text-sm font-medium" style="color: #94a3b8;" id="todayDate"></p>
            </div>
          </div>

          <!-- Omnisearch Bar -->
          <div class="hidden sm:flex flex-1 max-w-xl">
            <div class="omnisearch-wrapper relative w-full group">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="w-4 h-4 transition-colors duration-200" style="color: #94a3b8;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <input
                id="omnisearchInput"
                type="text"
                class="omnisearch-input w-full pl-10 pr-20 py-2.5 rounded-xl text-sm transition-all duration-200 outline-none"
                style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #1e293b;"
                placeholder="Buscar paciente (ej. Maximus) o cliente (ej. Juan Antonio)..."
              />
              <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <span class="omnisearch-kbd flex items-center gap-1 px-2 py-1 rounded-md text-[10px] font-semibold" style="background: #e2e8f0; color: #64748b; border: 1px solid #cbd5e1;">
                  <span>Ctrl</span><span>+</span><span>K</span>
                </span>
              </div>
            </div>
          </div>

          <div class="flex items-center space-x-3 flex-shrink-0">
            <!-- TODO: Activar en Avance 2 / Avance 3 (Calendario de citas) - Calendar Popup Button
            <div class="relative">
              <button id="calendarPopupBtn" class="relative p-2.5 rounded-xl transition-all duration-200 hover:bg-slate-100" style="color: #64748b;" title="Calendario de citas">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </button>
            </div>
            -->

            <!-- Tasks Popup Button -->
            <div class="relative">
              <button id="tasksPopupBtn" class="relative p-2.5 rounded-xl transition-all duration-200 hover:bg-slate-100" style="color: #64748b;" title="Tareas Pendientes">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                </svg>
                <span id="todoCountBadge" class="absolute top-1 right-1 min-w-[18px] h-[18px] rounded-full text-[10px] text-white flex items-center justify-center font-bold ring-2 ring-white" style="background: #3b82f6;">0</span>
              </button>
              <!-- Tasks Popup Panel -->
              <div id="tasksPopupPanel" class="tasks-popup-panel hidden absolute right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl z-50 overflow-hidden" style="border: 1px solid #e2e8f0; width: 520px;">
                <!-- Header -->
                <div class="px-5 py-3.5 flex items-center justify-between" style="border-bottom: 1px solid #e2e8f0; background: linear-gradient(135deg, #f8fafc, #ffffff);">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
                      <svg class="w-4 h-4" style="color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-[13px] font-bold" style="color: #0f172a;">Mis Tareas</h3>
                      <p class="text-[10px]" style="color: #94a3b8;"><span id="todoPopupCount">0</span> pendientes</p>
                    </div>
                  </div>
                  <button id="closeTasksPopup" class="p-1.5 rounded-lg transition-colors hover:bg-slate-100" style="color: #94a3b8;">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>
                <!-- Filter Tabs + Search -->
                <div class="px-4 pt-3 pb-2" style="border-bottom: 1px solid #f1f5f9;">
                  <div class="flex items-center gap-1.5 mb-2.5">
                    <button class="todo-filter-tab active" data-filter="all">Todas</button>
                    <button class="todo-filter-tab" data-filter="pending">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                      Pendientes
                    </button>
                    <button class="todo-filter-tab" data-filter="completed">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                      Completadas
                    </button>
                    <button class="todo-filter-tab" data-filter="cancelled">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                      Canceladas
                    </button>
                  </div>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <svg class="w-3.5 h-3.5" style="color: #94a3b8;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                      </svg>
                    </div>
                    <input id="todoSearchInput" type="text" class="w-full pl-9 pr-3 py-2 rounded-lg text-xs outline-none transition-all duration-200" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #334155;" placeholder="Buscar tarea..." />
                  </div>
                </div>
                <!-- Todo List -->
                <div id="todoList" class="todo-list-container"></div>
                <!-- Add Task -->
                <div class="px-4 py-3" style="border-top: 1px solid #e2e8f0; background: #fafbfc;">
                  <div class="flex items-center gap-2">
                    <input id="todoNewInput" type="text" class="flex-1 px-3 py-2 rounded-lg text-xs outline-none transition-all duration-200" style="background: #ffffff; border: 1px solid #e2e8f0; color: #334155;" placeholder="Escribe una nueva tarea..." />
                    <button id="todoAddBtn" class="px-3.5 py-2 rounded-lg text-[11px] font-semibold text-white transition-all duration-200 hover:shadow-md active:scale-95 flex items-center gap-1.5" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                      Añadir
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <!-- TODO: Activar en Avance 2 / Avance 3 (Notificaciones) - Notification Bell
            <button id="notificationBtn" class="relative p-2.5 rounded-xl transition-all duration-200 hover:bg-slate-100" style="color: #64748b;">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
              </svg>
              <span id="notificationBadge" class="absolute top-1 right-1 w-4.5 h-4.5 bg-red-500 rounded-full text-[10px] text-white flex items-center justify-center font-bold ring-2 ring-white" style="display: none;">0</span>
            </button>
            -->
            <!-- User avatar in header -->
            <div class="hidden sm:flex items-center space-x-2 pl-3" style="border-left: 1px solid #e2e8f0;">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white" style="background: linear-gradient(135deg, #3b82f6, #60a5fa);" id="headerAvatar">V</div>
              <div class="hidden md:block">
                <p class="text-xs font-semibold" style="color: #1e293b;" id="headerVetName">Veterinaria</p>
                <p class="text-[10px]" style="color: #94a3b8;">Administrador</p>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- Dashboard Content -->
      <main class="px-4 sm:px-6 lg:px-8 py-6 max-w-7xl mx-auto">

        <!-- Welcome Banner -->
        <div class="dash-card rounded-2xl p-6 sm:p-8 mb-6 relative overflow-hidden" style="background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 60%, #162033 100%);">
          <!-- Decorative floating shapes -->
          <div class="absolute top-0 right-0 w-72 h-72 rounded-full" style="background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%); transform: translate(30%, -40%);"></div>
          <div class="absolute bottom-0 left-0 w-40 h-40 rounded-full" style="background: radial-gradient(circle, rgba(96,165,250,0.1) 0%, transparent 70%); transform: translate(-20%, 30%);"></div>
          <div class="absolute top-1/2 right-1/4 w-2 h-2 rounded-full" style="background: rgba(96,165,250,0.4);"></div>
          <div class="absolute top-1/3 right-1/3 w-1.5 h-1.5 rounded-full" style="background: rgba(148,196,255,0.3);"></div>
          <div class="absolute bottom-1/4 right-1/5 w-1 h-1 rounded-full" style="background: rgba(59,130,246,0.5);"></div>

          <div class="relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center space-x-2 mb-2">
                <div class="w-2 h-2 rounded-full animate-pulse" style="background: #60a5fa;"></div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.15em]" style="color: rgba(148,196,255,0.7);">Panel Veterinario</p>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold mb-1 text-white leading-tight" id="welcomeMessage">¡Hola! Estamos listos para otro gran día.</h2>
              <p class="text-sm" style="color: rgba(148,196,255,0.6);">Gestiona tu veterinaria de forma eficiente y profesional</p>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0">
              <div class="flex items-center space-x-2 rounded-xl px-4 py-2" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(8px);">
                <svg class="w-4 h-4" style="color: #60a5fa;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span class="text-xs font-medium text-white/80" id="bannerDate"></span>
              </div>
            </div>
          </div>
        </div>



        <!-- Quick Access Shortcuts -->
        <div class="dash-card mb-6" style="animation-delay: 0.25s;">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold tracking-tight" style="color: #0f172a;">Accesos Rápidos</h3>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <!-- Nuevo Cliente -->
            <a href="/clientes" data-only-secretaria class="shortcut-btn group flex flex-col items-center gap-2.5 p-4 rounded-xl bg-white transition-all duration-200 hover:shadow-md" style="border: 1px solid #e2e8f0;">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center transition-transform duration-200 group-hover:scale-110" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);">
                <svg class="w-5 h-5" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
              </div>
              <span class="text-xs font-semibold" style="color: #334155;">Nuevo Cliente</span>
            </a>
            <!-- Nueva Mascota -->
            <a href="/mascotas" data-only-secretaria class="shortcut-btn group flex flex-col items-center gap-2.5 p-4 rounded-xl bg-white transition-all duration-200 hover:shadow-md" style="border: 1px solid #e2e8f0;">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center transition-transform duration-200 group-hover:scale-110" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);">
                <svg class="w-5 h-5" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <span class="text-xs font-semibold" style="color: #334155;">Nueva Mascota</span>
            </a>
            <!-- TODO: Activar en Avance 2 / Avance 3 (acceso rapido a Citas y Reportes; restaurar sm:grid-cols-4 en el grid) - Agendar Cita
            <a href="/citas" class="shortcut-btn group flex flex-col items-center gap-2.5 p-4 rounded-xl bg-white transition-all duration-200 hover:shadow-md" style="border: 1px solid #e2e8f0;">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center transition-transform duration-200 group-hover:scale-110" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);">
                <svg class="w-5 h-5" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              </div>
              <span class="text-xs font-semibold" style="color: #334155;">Agendar Cita</span>
            </a>
            Ver Reportes
            <a href="/reportes" data-only-secretaria class="shortcut-btn group flex flex-col items-center gap-2.5 p-4 rounded-xl bg-white transition-all duration-200 hover:shadow-md" style="border: 1px solid #e2e8f0;">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center transition-transform duration-200 group-hover:scale-110" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);">
                <svg class="w-5 h-5" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              </div>
              <span class="text-xs font-semibold" style="color: #334155;">Ver Reportes</span>
            </a>
            -->
          </div>
        </div>

        <!-- Search Results Dropdown -->
        <div id="searchDropdown" class="hidden fixed z-50 bg-white rounded-xl shadow-2xl overflow-hidden" style="border: 1px solid #e2e8f0; max-height: 400px; overflow-y: auto;">
        </div>

        <!-- Resumen: Usuarios, Clientes y Mascotas -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
          <a href="/usuarios" data-only-secretaria class="metric-card dash-card bg-white rounded-2xl p-5 flex items-center justify-between" style="border: 1px solid #e2e8f0; animation-delay: 0.3s;">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide" style="color: #94a3b8;">Usuarios</p>
              <p class="text-3xl font-bold mt-1" style="color: #0f172a;" id="metricUsuarios">--</p>
              <p class="text-xs mt-1" style="color: #94a3b8;"><span id="metricUsuariosDetalle">Activos en la veterinaria</span></p>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);">
              <svg class="w-6 h-6" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
          </a>
          <a href="/clientes" class="metric-card dash-card bg-white rounded-2xl p-5 flex items-center justify-between" style="border: 1px solid #e2e8f0; animation-delay: 0.35s;">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide" style="color: #94a3b8;">Clientes</p>
              <p class="text-3xl font-bold mt-1" style="color: #0f172a;" id="metricClientes">--</p>
              <p class="text-xs mt-1" style="color: #94a3b8;">Dueños registrados</p>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);">
              <svg class="w-6 h-6" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
          </a>
          <a href="/mascotas" class="metric-card dash-card bg-white rounded-2xl p-5 flex items-center justify-between" style="border: 1px solid #e2e8f0; animation-delay: 0.4s;">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide" style="color: #94a3b8;">Mascotas</p>
              <p class="text-3xl font-bold mt-1" style="color: #0f172a;" id="metricMascotas">--</p>
              <p class="text-xs mt-1" style="color: #94a3b8;">Pacientes registrados</p>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);">
              <svg class="w-6 h-6" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            </div>
          </a>
        </div>

        <!-- TODO: Activar en Avance 2 / Avance 3 (Citas pendientes y Citas de hoy) - Citas Grid: Side by Side
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
          Citas Pendientes por Confirmar
          <div class="dash-card" style="animation-delay: 0.3s;">
            <div class="bg-white rounded-2xl overflow-hidden h-full flex flex-col" style="border: 1px solid #e2e8f0;">
              <div class="px-5 py-4 flex items-center justify-between flex-shrink-0" style="border-bottom: 1px solid #f1f5f9;">
                <div class="flex items-center space-x-2">
                  <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
                    <svg class="w-3.5 h-3.5" style="color: #d97706;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <h3 class="text-sm font-bold" style="color: #0f172a;">Citas Pendientes por Confirmar</h3>
                  <span id="pendientesCount" class="hidden text-[10px] font-bold px-2 py-0.5 rounded-full text-white" style="background: #d97706;">0</span>
                </div>
                <a href="/citas" class="text-xs font-semibold flex items-center space-x-1 transition-colors hover:opacity-80 flex-shrink-0" style="color: #3b82f6;">
                  <span>Ir a citas</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
              </div>
              Loading
              <div id="pendientesLoading" class="p-8 text-center">
                <div class="w-8 h-8 rounded-full border-2 border-amber-200 border-t-amber-500 animate-spin mx-auto"></div>
                <p class="text-xs mt-3" style="color: #94a3b8;">Cargando citas pendientes...</p>
              </div>
              Empty
              <div id="pendientesEmpty" class="px-5 py-8 text-center hidden">
