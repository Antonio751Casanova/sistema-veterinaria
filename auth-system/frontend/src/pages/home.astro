<style>
  :global(body) {
    background: #f1f5f9 !important;
  }

  /* Staggered card entrance animation */
  @keyframes dashCardIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dash-card {
    animation: dashCardIn 0.5s ease-out both;
  }

  /* Metric card hover */
  .metric-card {
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .metric-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px -5px rgba(0, 0, 0, 0.08), 0 4px 10px -6px rgba(0, 0, 0, 0.04);
  }

  /* Shortcut buttons hover */
  .shortcut-btn:hover {
    border-color: #cbd5e1 !important;
  }

  /* Omnisearch */
  .omnisearch-input:focus {
    background: #ffffff !important;
    border-color: #3b82f6 !important;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }
  .omnisearch-input:focus + .omnisearch-kbd-wrapper .omnisearch-kbd,
  .omnisearch-input:focus ~ div .omnisearch-kbd {
    opacity: 0;
  }
  .omnisearch-input::placeholder {
    color: #94a3b8;
    font-size: 13px;
  }

  /* Tasks Popup Panel */
  .tasks-popup-panel {
    animation: popupIn 0.2s ease-out;
  }
  .calendar-overlay {
    background: rgba(15, 23, 42, 0.38);
    backdrop-filter: blur(2px);
  }
  .calendar-overlay[data-open='false'] {
    display: none;
  }
  .calendar-popup-panel {
    animation: popupIn 0.2s ease-out;
    flex-direction: column;
    max-height: 90vh;
  }
  .calendar-modal-body {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .calendar-left-col {
    width: 58%;
    padding: 12px 14px 14px;
    border-right: 1px solid #e5e7eb;
    height: 100%;
    overflow-y: auto;
  }
  .calendar-right-col {
    width: 42%;
    padding: 12px;
    height: 100%;
    overflow-y: hidden;
  }
  .calendar-right-col::-webkit-scrollbar {
    width: 5px;
  }
  .calendar-right-col::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 9999px;
  }

  .calendar-bottom-section {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  @keyframes popupIn {
    from { opacity: 0; transform: translateY(-8px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ===== Todo dynamic content: must be :global since rendered via JS innerHTML ===== */
  :global(.todo-list-container) {
    max-height: 400px;
    overflow-y: auto;
  }
  :global(.todo-list-container::-webkit-scrollbar) {
    width: 4px;
  }
  :global(.todo-list-container::-webkit-scrollbar-track) {
    background: transparent;
  }
  :global(.todo-list-container::-webkit-scrollbar-thumb) {
    background: #e2e8f0;
    border-radius: 4px;
  }

  /* Filter Tabs */
  .todo-filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    background: #f1f5f9;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 150ms ease;
    white-space: nowrap;
  }
  .todo-filter-tab:hover {
    background: #e2e8f0;
    color: #334155;
  }
  .todo-filter-tab.active {
    background: #eff6ff;
    color: #2563eb;
    border-color: #bfdbfe;
  }

  /* Todo Items — :global for JS-rendered content */
  :global(.todo-item) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    transition: background 150ms ease;
    border-bottom: 1px solid #f1f5f9;
    position: relative;
  }
  :global(.todo-item:last-child) {
    border-bottom: none;
  }
  :global(.todo-item:hover) {
    background: #f8fafc;
  }

  /* Native checkbox styling */
  :global(.todo-cb) {
    appearance: none;
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    min-width: 20px;
    border: 2px solid #cbd5e1;
    border-radius: 6px;
    cursor: pointer;
    transition: all 150ms ease;
    position: relative;
    flex-shrink: 0;
    background: white;
  }
  :global(.todo-cb:hover) {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.08);
  }
  :global(.todo-cb:checked) {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    border-color: #22c55e;
  }
  :global(.todo-cb:checked::after) {
    content: '';
    position: absolute;
    left: 5px;
    top: 1px;
    width: 6px;
    height: 11px;
    border: solid white;
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg);
  }
  :global(.todo-cb.cancelled) {
    background: #fee2e2;
    border-color: #fca5a5;
    cursor: default;
  }
  :global(.todo-cb.cancelled::before),
  :global(.todo-cb.cancelled::after) {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 2px;
    background: #ef4444;
    border: none;
    border-radius: 1px;
  }
  :global(.todo-cb.cancelled::before) {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  :global(.todo-cb.cancelled::after) {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  :global(.todo-content) {
    flex: 1;
    min-width: 0;
  }
  :global(.todo-text) {
    font-size: 13px;
    color: #1e293b;
    line-height: 1.4;
    word-break: break-word;
  }
  :global(.todo-text.truncated) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.todo-text.expanded) {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }
  :global(.todo-expand-btn) {
    font-size: 10px;
    color: #3b82f6;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    margin-top: 2px;
    font-weight: 600;
