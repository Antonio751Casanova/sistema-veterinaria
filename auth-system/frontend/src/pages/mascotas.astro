---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Mascotas - Sistema Veterinarias">
  <Sidebar />
  <div class="lg:ml-64 min-h-screen transition-[margin] duration-200" style="background: #f1f5f9;" data-main-content>
    <!-- Sticky Header -->
    <header class="sticky top-0 z-30 backdrop-blur-md" style="background: rgba(255,255,255,0.8); border-bottom: 1px solid #e2e8f0;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center space-x-3">
        <button id="hamburgerBtn" class="lg:hidden p-2 rounded-lg hover:bg-black/5" style="color: #0f172a;">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <div>
          <h1 class="text-xl md:text-2xl font-bold" style="color: #0f172a;">Gesti&#243;n de Mascotas</h1>
          <p id="pageSubtitle" class="text-sm" style="color: #9a8b7c;">Administra las mascotas registradas</p>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
      <!-- Header Buttons -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
        <a href="/clientes" class="flex items-center space-x-2 hover:opacity-70 transition-colors" style="color: #9a8b7c;">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <span class="text-sm">Volver a Clientes</span>
        </a>
        <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
          <a
            href="/clientes"
            class="px-4 md:px-6 py-3 font-semibold rounded-xl hover:bg-black/5 transition-all duration-200 flex items-center justify-center space-x-2"
            style="border: 1px solid #e2e8f0; color: #0f172a;"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>
            <span>Nuevo Cliente</span>
          </a>
          <button
            id="addPetBtn"
            class="px-4 md:px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-xl hover:from-blue-600 hover:to-blue-700 transition-all duration-200 flex items-center justify-center space-x-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Nueva Mascota</span>
          </button>
        </div>
      </div>

      <!-- Total Mascotas -->
      <div class="bg-white rounded-xl p-4 mb-6 flex items-center justify-between" style="border: 1px solid #e2e8f0;">
        <div>
          <p class="text-xs" style="color: #9a8b7c;">Total Mascotas</p>
          <p id="totalMascotas" class="text-2xl font-bold mt-1" style="color: #0f172a;">0</p>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center">
            <span class="text-xl">&#128062;</span>
          </div>
          <!-- TODO: Activar en Avance 2 / Avance 3 --> <a href="/estadisticas" class="text-sm hover:opacity-70 flex items-center gap-1" style="color: #3b82f6;">
            Ver estad&#237;sticas
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>

      <!-- Pets Table Card -->
      <div class="bg-white rounded-2xl overflow-hidden" style="border: 1px solid #e2e8f0;">
        <!-- Search and Filter -->
        <div class="p-4" style="border-bottom: 1px solid #e2e8f0;">
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1 flex gap-2">
              <select
                id="searchType"
                class="rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;"
              >
                <option value="todo" class="bg-white">Todo</option>
                <option value="id" class="bg-white">ID</option>
                <option value="nombre" class="bg-white">Nombre</option>
              </select>
              <div class="relative flex-1">
                <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5" style="color: #9a8b7c;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input
                  type="text"
                  id="searchInput"
                  placeholder="Buscar mascota..."
                  class="w-full pl-10 pr-4 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;"
                />
              </div>
            </div>
            <div class="flex gap-2 flex-wrap">
              <select id="speciesFilter" class="px-4 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;">
                <option value="" class="bg-white">Todas las especies</option>
                <option value="Perro" class="bg-white">Perros</option>
                <option value="Gato" class="bg-white">Gatos</option>
                <option value="Ave" class="bg-white">Aves</option>
                <option value="Roedor" class="bg-white">Roedores</option>
                <option value="Reptil" class="bg-white">Reptiles</option>
                <option value="Pez" class="bg-white">Peces</option>
                <option value="Anfibio" class="bg-white">Anfibios</option>
                <option value="Exotico" class="bg-white">Exoticos</option>
                <option value="Otro" class="bg-white">Otros</option>
              </select>
              <div class="relative">
                <input type="text" id="clientFilterInput" placeholder="Buscar due&#241;o..." class="px-4 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 w-48" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" autocomplete="off" />
                <input type="hidden" id="clientFilter" value="" />
                <div id="clientFilterDropdown" class="absolute z-50 top-full left-0 right-0 mt-1 bg-white rounded-lg max-h-48 overflow-y-auto hidden shadow-lg" style="border: 1px solid #e2e8f0;"></div>
                <button type="button" id="clearClientFilter" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 hidden">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="p-12 text-center">
          <svg class="animate-spin h-8 w-8 mx-auto text-blue-500" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="mt-4" style="color: #9a8b7c;">Cargando mascotas...</p>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden p-12 text-center">
          <div class="w-16 h-16 rounded-full bg-gray-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" style="color: #9a8b7c;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <p style="color: #9a8b7c;">No hay mascotas registradas</p>
          <p class="text-sm mt-1" style="color: #94a3b8;">Agrega la primera mascota para comenzar</p>
        </div>

        <!-- Table -->
        <div id="tableContainer" class="hidden">
          <!-- Top Pagination -->
          <div id="paginationTop" class="hidden p-4 flex-col sm:flex-row items-center justify-between gap-4" style="border-bottom: 1px solid #e2e8f0;">
            <p class="text-sm" style="color: #9a8b7c;">
              Mostrando <span class="showingFromSync">1</span>-<span class="showingToSync">10</span> de <span class="totalItemsSync">0</span> mascotas
            </p>
            <div class="flex items-center space-x-2">
              <button class="prevPageSync px-3 py-2 bg-[#f8fafc] rounded-lg disabled:opacity-50 disabled:cursor-not-allowed transition-colors hover:bg-black/5" style="border: 1px solid #e2e8f0; color: #475569;">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <span class="px-3 text-sm" style="color: #0f172a;">P&#225;gina <span class="currentPageSync">1</span> de <span class="totalPagesSync">1</span></span>
              <button class="nextPageSync px-3 py-2 bg-[#f8fafc] rounded-lg disabled:opacity-50 disabled:cursor-not-allowed transition-colors hover:bg-black/5" style="border: 1px solid #e2e8f0; color: #475569;">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="hidden md:table-header-group" style="background: #f8fafc;">
                <tr>
                  <th class="px-4 md:px-6 py-4 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">ID</th>
                  <th class="px-4 md:px-6 py-4 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Mascota</th>
                  <th class="px-4 md:px-6 py-4 text-left text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Especie</th>
                  <th class="px-4 md:px-6 py-4 text-left text-xs font-medium uppercase tracking-wider hidden lg:table-cell" style="color: #9a8b7c;">Due&#241;o</th>
                  <th class="px-4 md:px-6 py-4 text-left text-xs font-medium uppercase tracking-wider hidden xl:table-cell" style="color: #9a8b7c;">Edad/Peso</th>
                  <th class="px-4 md:px-6 py-4 text-right text-xs font-medium uppercase tracking-wider" style="color: #9a8b7c;">Acciones</th>
                </tr>
              </thead>
              <tbody id="petsTableBody" class="divide-y divide-[#e2e8f0]">
                <!-- Rows inserted by JS -->
              </tbody>
            </table>
          </div>

          <!-- Bottom Pagination -->
          <div id="paginationContainer" class="hidden p-4 flex-col sm:flex-row items-center justify-between gap-4" style="border-top: 1px solid #e2e8f0;">
            <p class="text-sm" style="color: #9a8b7c;">
              Mostrando <span class="showingFromSync">1</span>-<span class="showingToSync">10</span> de <span class="totalItemsSync">0</span> mascotas
            </p>
            <div class="flex items-center space-x-2">
              <button class="prevPageSync px-3 py-2 bg-[#f8fafc] rounded-lg disabled:opacity-50 disabled:cursor-not-allowed transition-colors hover:bg-black/5" style="border: 1px solid #e2e8f0; color: #475569;">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <span class="px-3 text-sm" style="color: #0f172a;">P&#225;gina <span class="currentPageSync">1</span> de <span class="totalPagesSync">1</span></span>
              <button class="nextPageSync px-3 py-2 bg-[#f8fafc] rounded-lg disabled:opacity-50 disabled:cursor-not-allowed transition-colors hover:bg-black/5" style="border: 1px solid #e2e8f0; color: #475569;">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Add/Edit Pet Modal -->
  <div id="petModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50">
    <div class="bg-white rounded-2xl w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto" style="border: 1px solid #e2e8f0;">
      <div class="p-4 md:p-6 flex justify-between items-center sticky top-0 bg-white" style="border-bottom: 1px solid #e2e8f0;">
        <h3 id="petModalTitle" class="text-xl font-semibold" style="color: #0f172a;">Nueva Mascota</h3>
        <button id="closePetModal" class="p-1 hover:opacity-70" style="color: #9a8b7c;">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="petForm" class="p-4 md:p-6 space-y-4">
        <input type="hidden" id="petId" name="petId" />
        <input type="hidden" id="petClienteId" name="petClienteId" />

        <div>
          <label class="block text-sm font-medium mb-2" style="color: #475569;">Due&#241;o *</label>
          <div class="flex gap-2 mb-2">
            <select id="clienteSearchType" class="px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;">
              <option value="nombre" class="bg-white">Por Nombre</option>
              <option value="telefono" class="bg-white">Por Telefono</option>
              <option value="id" class="bg-white">Por ID</option>
            </select>
            <div class="relative flex-1">
              <input type="text" id="clienteSearch" placeholder="Escribe para buscar..." autocomplete="off" class="w-full px-4 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" />
              <input type="hidden" name="cliente_id" id="clienteIdHidden" required />
              <div id="clienteDropdown" class="absolute z-50 top-full left-0 right-0 mt-1 bg-white rounded-lg max-h-48 overflow-y-auto hidden shadow-lg" style="border: 1px solid #e2e8f0;"></div>
            </div>
          </div>
          <p id="selectedClientInfo" class="text-sm mt-2 hidden" style="color: #3b82f6;"></p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-2" style="color: #475569;">Nombre *</label>
            <input type="text" name="nombre" required maxlength="100" class="w-full px-4 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" placeholder="Max" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2" style="color: #475569;">Especie *</label>
            <input type="text" name="especie" id="especieInput" list="especiesList" required maxlength="50" class="w-full px-4 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" placeholder="Ej: Perro, Gato..." />
            <datalist id="especiesList">
              <option value="Perro"></option>
              <option value="Gato"></option>
              <option value="Ave"></option>
              <option value="Roedor"></option>
              <option value="Reptil"></option>
              <option value="Pez"></option>
              <option value="Anfibio"></option>
              <option value="Exotico"></option>
            </datalist>
            <p class="text-xs mt-1" style="color: #94a3b8;">Si la especie no est&#225; en la lista, escr&#237;bela y se guardar&#225; autom&#225;ticamente.</p>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-2" style="color: #475569;">Raza</label>
          <input type="text" name="raza" id="razaInput" list="razasList" maxlength="100" class="w-full px-4 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" placeholder="Ej: Labrador, Siam&#233;s..." />
          <datalist id="razasList">
            <!-- Dynamic options from JS -->
          </datalist>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-2" style="color: #475569;">Edad</label>
            <div class="grid grid-cols-2 gap-2">
              <div class="relative">
                <input type="number" name="edad_anios" min="0" max="100" step="1" class="w-full pl-3 pr-12 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" placeholder="0" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs pointer-events-none" style="color: #9a8b7c;">a&#241;os</span>
              </div>
              <div class="relative">
                <input type="number" name="edad_meses" min="0" max="11" step="1" class="w-full pl-3 pr-14 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" placeholder="0" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs pointer-events-none" style="color: #9a8b7c;">meses</span>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium mb-2" style="color: #475569;">Peso</label>
            <div class="flex gap-2">
              <input type="number" name="peso_valor" min="0" max="500" step="0.1" class="flex-1 px-3 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" placeholder="15" />
              <select name="peso_unidad" class="w-16 px-2 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;">
                <option value="kg" class="bg-white">kg</option>
                <option value="g" class="bg-white">g</option>
              </select>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-2" style="color: #475569;">Notas</label>
          <textarea name="notas" rows="2" maxlength="500" class="w-full px-4 py-2.5 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a;" placeholder="Alergias, condiciones especiales, etc."></textarea>
        </div>

        <!-- Error Message -->
        <div id="petFormError" class="hidden p-3 bg-red-50 rounded-xl" style="border: 1px solid #fecaca;">
          <p class="text-red-600 text-sm text-center" id="petFormErrorText"></p>
        </div>

        <!-- Buttons -->
        <div class="flex justify-end space-x-3 pt-2">
          <button type="button" id="cancelPetBtn" class="px-4 py-2 transition-colors hover:opacity-70" style="color: #475569;">
            Cancelar
          </button>
          <button type="submit" class="px-6 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-xl hover:from-blue-600 hover:to-blue-700 transition-all duration-200">
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50">
    <div class="bg-white rounded-2xl w-full max-w-md mx-4 p-6" style="border: 1px solid #e2e8f0;">
      <div class="text-center">
        <div class="w-16 h-16 rounded-full bg-red-500/20 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-2" style="color: #0f172a;">&#191;Eliminar mascota?</h3>
        <p class="mb-6 text-sm" style="color: #9a8b7c;">Se eliminar&#225; todo el historial m&#233;dico. Esta acci&#243;n no se puede deshacer.</p>
        <div class="flex justify-center space-x-4">
          <button id="cancelDelete" class="px-6 py-2 transition-colors hover:opacity-70" style="color: #475569;">
            Cancelar
          </button>
          <button id="confirmDelete" class="px-6 py-2 bg-red-500 text-white font-semibold rounded-xl hover:bg-red-600 transition-colors">
            Eliminar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bitacora Modal -->
  <div id="bitacoraModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50">
