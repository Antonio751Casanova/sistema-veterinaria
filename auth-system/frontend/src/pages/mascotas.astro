      'Eclectus', 'Caique', 'Quaker', 'Loro Senegalés'
    ],
    'Roedor': [
      'Hamster Sirio', 'Hamster Ruso', 'Hamster Roborovski', 'Cobaya', 'Conejo Holandes', 'Conejo Belier',
      'Conejo Rex', 'Conejo Angora', 'Conejo Cabeza de Leon', 'Rata Domestica', 'Raton Domestico',
      'Chinchilla', 'Huron', 'Jerbo', 'Ardilla de Richardson', 'Degú', 'Erizo Africano'
    ],
    'Reptil': [
      'Iguana Verde', 'Tortuga de Orejas Rojas', 'Tortuga Rusa', 'Tortuga Sulcata', 'Gecko Leopardo',
      'Gecko Crestado', 'Dragon Barbudo', 'Python Ball', 'Boa Constrictor', 'Serpiente del Maiz',
      'Camaleon Velado', 'Camaleon Pantera', 'Monitor de Sabana', 'Tegu Argentino', 'Tortuga de Caja',
      'Tortuga Mora', 'Axolotl', 'Salamandra'
    ],
    'Pez': [
      'Betta', 'Goldfish', 'Guppy', 'Molly', 'Platy', 'Tetra Neon', 'Pez Angel', 'Disco', 'Oscar',
      'Cichilido', 'Corydora', 'Pleco', 'Pez Payaso', 'Pez Cirujano', 'Pez Damisela', 'Pez Globo',
      'Carpa Koi', 'Pez Bichir'
    ],
    'Anfibio': [
      'Rana Arboricola', 'Rana Africana', 'Sapo Comun', 'Axolotl', 'Salamandra de Fuego',
      'Triton Japones', 'Rana Punta de Flecha', 'Sapo de Caña'
    ],
    'Exotico': [
      'Mono Capuchino', 'Mono Titi', 'Sugar Glider', 'Perezoso', 'Mapache', 'Coati', 'Kinkaju',
      'Feneco', 'Zorro', 'Mofeta', 'Armadillo', 'Capibaraa', 'Mini Pig', 'Cabra Enana'
    ],
  };

  // Species colors and emojis
  const speciesEmojis: Record<string, string> = { 'Perro': '🐕', 'Gato': '🐱', 'Ave': '🦜', 'Roedor': '🐹', 'Reptil': '🦎', 'Pez': '🐠', 'Anfibio': '🐸', 'Exotico': '🦥', 'Otro': '🐾' };
  const speciesColors: Record<string, string> = { 'Perro': 'bg-amber-500/20', 'Gato': 'bg-purple-500/20', 'Ave': 'bg-sky-500/20', 'Roedor': 'bg-pink-500/20', 'Reptil': 'bg-lime-500/20', 'Pez': 'bg-cyan-500/20', 'Anfibio': 'bg-green-500/20', 'Exotico': 'bg-orange-500/20', 'Otro': 'bg-gray-500/20' };
  const speciesBadgeColors: Record<string, string> = { 'Perro': 'bg-amber-500/20 text-amber-300', 'Gato': 'bg-purple-500/20 text-purple-300', 'Ave': 'bg-sky-500/20 text-sky-300', 'Roedor': 'bg-pink-500/20 text-pink-300', 'Reptil': 'bg-lime-500/20 text-lime-300', 'Pez': 'bg-cyan-500/20 text-cyan-300', 'Anfibio': 'bg-green-500/20 text-green-300', 'Exotico': 'bg-orange-500/20 text-orange-300', 'Otro': 'bg-gray-500/20 text-gray-300' };

  // Load vet name
  const vet = getVeterinaria();
  if (vet) {
    vetNameEl.textContent = vet.nombre;
    if (sidebarVetName) sidebarVetName.textContent = vet.nombre;
    if (userAvatar) userAvatar.textContent = vet.nombre.charAt(0).toUpperCase();
  }

  // Sidebar toggle
  hamburgerBtn.addEventListener('click', () => {
    sidebar.classList.toggle('-translate-x-full');
    sidebarOverlay.classList.toggle('hidden');
  });
  sidebarOverlay.addEventListener('click', () => {
    sidebar.classList.add('-translate-x-full');
    sidebarOverlay.classList.add('hidden');
  });

  // ── Custom species/breed persistence ──────────────────────────
  function getCustomSpecies(): string[] {
    try { return JSON.parse(localStorage.getItem(LS_CUSTOM_SPECIES) || '[]'); } catch { return []; }
  }
  function saveCustomSpeciesList(list: string[]) {
    localStorage.setItem(LS_CUSTOM_SPECIES, JSON.stringify(list));
  }
  function getCustomBreeds(species: string): string[] {
    try { return JSON.parse(localStorage.getItem(LS_CUSTOM_BREEDS + species) || '[]'); } catch { return []; }
  }
  function saveCustomBreedsList(species: string, list: string[]) {
    localStorage.setItem(LS_CUSTOM_BREEDS + species, JSON.stringify(list));
  }

  // Inject custom species into datalist + filter dropdown
  function loadCustomSpeciesOptions() {
    const especiesDatalist = document.getElementById('especiesList') as HTMLDataListElement;
    getCustomSpecies().forEach(s => {
      if (!Array.from(especiesDatalist.options).some(o => o.value === s)) {
        const opt = document.createElement('option');
        opt.value = s;
        especiesDatalist.appendChild(opt);
      }
      if (!Array.from(speciesFilter.options).some(o => o.value === s)) {
        const opt = document.createElement('option');
        opt.value = s; opt.className = 'bg-white'; opt.textContent = s;
        speciesFilter.appendChild(opt);
      }
    });
  }

  // Persist a new species (if truly new) to localStorage
  function persistCustomSpecies(especie: string) {
    if (!especie || PREDEFINED_SPECIES.includes(especie)) return;
    const list = getCustomSpecies();
    if (list.includes(especie)) return;
    list.push(especie);
    saveCustomSpeciesList(list);
    // Update datalist
    const dl = document.getElementById('especiesList') as HTMLDataListElement;
    if (!Array.from(dl.options).some(o => o.value === especie)) {
      const opt = document.createElement('option'); opt.value = especie; dl.appendChild(opt);
    }
    // Update species filter dropdown
    if (!Array.from(speciesFilter.options).some(o => o.value === especie)) {
      const opt = document.createElement('option');
      opt.value = especie; opt.className = 'bg-white'; opt.textContent = especie;
      speciesFilter.appendChild(opt);
    }
  }

  // Persist a new breed for the given species
  function persistCustomBreed(especie: string, raza: string) {
    if (!especie || !raza) return;
    const predefined = breedsBySpecies[especie] || [];
    const custom = getCustomBreeds(especie);
    if (predefined.includes(raza) || custom.includes(raza)) return;
    custom.push(raza);
    saveCustomBreedsList(especie, custom);
  }
  // ────────────────────────────────────────────────────────────────

  // Update breeds when species changes (includes custom breeds)
  function updateBreeds(species: string) {
    const predefined = breedsBySpecies[species] || [];
    const custom = getCustomBreeds(species);
    const all = [...predefined, ...custom.filter(b => !predefined.includes(b))];
    razasList.innerHTML = all.map(b => `<option value="${b}"></option>`).join('');
  }

  especieInput.addEventListener('input', () => updateBreeds(especieInput.value));

  // Client autocomplete functionality
  let selectedClientId: number | null = null;

  function updateClientDropdown() {
    const term = clienteSearch.value.trim();
    const searchTypeValue = clienteSearchType.value;
    if (!term) {
      clienteDropdown.classList.add('hidden');
      return;
    }

    const matches = clients.filter(c => {
      if (searchTypeValue === 'id') {
        return c.id.toString() === term;
      } else if (searchTypeValue === 'telefono') {
        const digitsOnly = term.replace(/\D/g, '');
        return c.telefono.replace(/\D/g, '').includes(digitsOnly);
      } else {
        return c.nombre.toLowerCase().includes(term.toLowerCase());
      }
    }).slice(0, 8);

    if (matches.length === 0) {
      clienteDropdown.innerHTML = '<div class="px-4 py-3 text-sm" style="color: #9a8b7c;">No se encontraron clientes</div>';
    } else {
      clienteDropdown.innerHTML = matches.map(c => `
        <button type="button" class="w-full px-4 py-3 text-left hover:bg-black/5 transition-colors" onclick="selectClient(${c.id}, '${c.nombre.replace(/'/g, "\\'")}', '${c.telefono}')">
          <p class="font-medium" style="color: #0f172a;">${c.nombre}</p>
          <p class="text-sm" style="color: #9a8b7c;">${c.telefono}</p>
        </button>
      `).join('');
    }
    clienteDropdown.classList.remove('hidden');
  }

  (window as any).selectClient = (id: number, nombre: string, telefono: string) => {
    selectedClientId = id;
    clienteIdHidden.value = id.toString();
    clienteSearch.value = nombre;
    selectedClientInfo.textContent = `✓ ${nombre} - ${telefono}`;
    selectedClientInfo.classList.remove('hidden');
    clienteDropdown.classList.add('hidden');
  };

  clienteSearch.addEventListener('input', updateClientDropdown);
  clienteSearch.addEventListener('focus', updateClientDropdown);
  clienteSearchType.addEventListener('change', () => {
    clienteSearch.value = '';
    clienteDropdown.classList.add('hidden');
    clienteSearch.focus();
  });
  document.addEventListener('click', (e) => {
    if (!clienteSearch.contains(e.target as Node) && !clienteDropdown.contains(e.target as Node)) {
      clienteDropdown.classList.add('hidden');
    }
  });

  // Client filter dropdown logic
  function updateClientFilterDropdown() {
    const term = clientFilterInput.value.toLowerCase().trim();

    if (!term) {
      clientFilterDropdown.classList.add('hidden');
      return;
    }

    const matches = clients.filter(c =>
      c.nombre.toLowerCase().includes(term) ||
      c.telefono.includes(term)
    ).slice(0, 8);

    if (matches.length === 0) {
      clientFilterDropdown.innerHTML = '<div class="px-4 py-2 text-sm" style="color: #9a8b7c;">No se encontraron clientes</div>';
    } else {
      clientFilterDropdown.innerHTML = matches.map(c => `
        <button type="button" class="w-full px-4 py-2 text-left hover:bg-black/5 transition-colors" onclick="selectClientFilter(${c.id}, '${c.nombre.replace(/'/g, "\\'")}')">
          <p class="font-medium text-sm" style="color: #0f172a;">${c.nombre}</p>
          <p class="text-xs" style="color: #9a8b7c;">${c.telefono}</p>
        </button>
      `).join('');
    }
    clientFilterDropdown.classList.remove('hidden');
  }

  (window as any).selectClientFilter = (id: number, nombre: string) => {
    clientFilter.value = id.toString();
    clientFilterInput.value = nombre;
    clientFilterDropdown.classList.add('hidden');
    clearClientFilter.classList.remove('hidden');
    applyFilters();
  };

  clientFilterInput.addEventListener('input', updateClientFilterDropdown);
  clientFilterInput.addEventListener('focus', updateClientFilterDropdown);
  document.addEventListener('click', (e) => {
    if (!clientFilterInput.contains(e.target as Node) && !clientFilterDropdown.contains(e.target as Node)) {
      clientFilterDropdown.classList.add('hidden');
    }
  });

  clearClientFilter.addEventListener('click', () => {
    clientFilter.value = '';
    clientFilterInput.value = '';
    clearClientFilter.classList.add('hidden');
    pageSubtitle.textContent = 'Gestiona las mascotas de la veterinaria';
    applyFilters();
  });

  // Load data
  async function loadData() {
    try {
      [pets, clients] = await Promise.all([listarMascotas(), listarClientes()]);

      // If client ID from URL, set filter
      if (clienteIdFromUrl) {
        clientFilter.value = clienteIdFromUrl;
        const client = clients.find(c => c.id === parseInt(clienteIdFromUrl));
        if (client) {
          clientFilterInput.value = client.nombre;
          clearClientFilter.classList.remove('hidden');
          pageSubtitle.textContent = `Mascotas de ${client.nombre}`;
        }
      }

      filteredPets = [...pets];
      applyFilters();
      updateStats();
      loadCustomSpeciesOptions();
    } catch (error) {
      console.error('Error loading data:', error);
    } finally {
      loadingState.classList.add('hidden');
    }
  }

  // Update stats
  function updateStats() {
    totalMascotasEl.textContent = pets.length.toString();
  }

  // Apply filters
  function applyFilters() {
    const searchTerm = searchInput.value.trim();
    const searchTermLower = searchTerm.toLowerCase();
    const searchTypeValue = searchType.value;
    const speciesValue = speciesFilter.value;
    const clientValue = clientFilter.value;

    filteredPets = pets.filter(pet => {
      // Search filter
      let matchesSearch = true;
      if (searchTerm) {
        switch (searchTypeValue) {
          case 'id':
            matchesSearch = pet.id.toString() === searchTerm;
            break;
          case 'nombre':
            matchesSearch = pet.nombre.toLowerCase().includes(searchTermLower);
            break;
          default: // 'todo'
            matchesSearch = pet.id.toString() === searchTerm ||
              pet.nombre.toLowerCase().includes(searchTermLower);
        }
      }
      const matchesSpecies = !speciesValue || pet.especie === speciesValue;
      const matchesClient = !clientValue || pet.cliente_id === parseInt(clientValue);
      return matchesSearch && matchesSpecies && matchesClient;
    });

    currentPage = 1;
    renderTable();
  }

  // Render table
  function renderTable() {
    if (filteredPets.length === 0) {
      tableContainer.classList.add('hidden');
      emptyState.classList.remove('hidden');
      paginationContainer.classList.add('hidden');
      paginationTop.classList.add('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    tableContainer.classList.remove('hidden');

    const totalPages = Math.ceil(filteredPets.length / itemsPerPage);
    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = Math.min(startIndex + itemsPerPage, filteredPets.length);
    const paginatedPets = filteredPets.slice(startIndex, endIndex);

    if (filteredPets.length > itemsPerPage) {
      paginationContainer.classList.remove('hidden');
      paginationContainer.classList.add('flex');
      paginationTop.classList.remove('hidden');
      paginationTop.classList.add('flex');

      showingFromEls.forEach(el => el.textContent = (startIndex + 1).toString());
      showingToEls.forEach(el => el.textContent = endIndex.toString());
      totalItemsEls.forEach(el => el.textContent = filteredPets.length.toString());
      currentPageDisplays.forEach(el => el.textContent = currentPage.toString());
      totalPagesDisplays.forEach(el => el.textContent = totalPages.toString());
      prevPageBtns.forEach(btn => btn.disabled = currentPage === 1);
      nextPageBtns.forEach(btn => btn.disabled = currentPage === totalPages);
    } else {
      paginationContainer.classList.add('hidden');
      paginationTop.classList.add('hidden');
    }

    petsTableBody.innerHTML = paginatedPets.map(pet => `
      <tr class="hover:bg-black/[0.02] transition-colors cursor-pointer" data-pet-id="${pet.id}" oncontextmenu="event.preventDefault(); showPetContextMenu(event, ${pet.id}, '${pet.nombre.replace(/'/g, "\\'")}')">
        <td class="px-4 md:px-6 py-4 text-sm hidden md:table-cell" style="color: #9a8b7c;">#${pet.id}</td>
        <td class="px-4 md:px-6 py-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full ${speciesColors[pet.especie] || 'bg-gray-500/20'} flex items-center justify-center flex-shrink-0">
              <span class="text-lg">${speciesEmojis[pet.especie] || '🐾'}</span>
            </div>
            <div class="min-w-0">
              <p class="font-medium truncate" style="color: #0f172a;">${pet.nombre}</p>
              <p class="text-sm truncate" style="color: #9a8b7c;">${pet.raza || '-'}</p>
            </div>
          </div>
        </td>
        <td class="px-4 md:px-6 py-4">
          <span class="px-2 py-1 rounded-full text-xs font-medium ${speciesBadgeColors[pet.especie] || 'bg-gray-500/20 text-gray-300'}">${pet.especie}</span>
        </td>
        <td class="px-4 md:px-6 py-4 hidden lg:table-cell">
          <p class="text-sm" style="color: #0f172a;">${pet.nombre_dueno}</p>
          <p class="text-xs" style="color: #94a3b8;">${pet.telefono_dueno}</p>
        </td>
        <td class="px-4 md:px-6 py-4 text-sm hidden xl:table-cell" style="color: #9a8b7c;">
          ${pet.edad || '-'} / ${pet.peso || '-'}
        </td>
        <td class="px-4 md:px-6 py-4">
          <div class="flex justify-end space-x-1">
            <button onclick="openBitacora(${pet.id}, '${pet.nombre}')" class="hidden p-2 text-blue-400 hover:text-blue-600 hover:bg-black/5 rounded-lg transition-colors" title="Bitácora">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </button>
            <button onclick="editPet(${pet.id})" class="p-2 text-blue-400 hover:text-blue-600 hover:bg-black/5 rounded-lg transition-colors" title="Editar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </button>
            <button onclick="deletePetPrompt(${pet.id})" class="p-2 text-red-500 hover:text-red-600 hover:bg-black/5 rounded-lg transition-colors" title="Eliminar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  // Modal functions
  function openPetModal(title: string, pet?: MascotaConDueno) {
    petModalTitle.textContent = title;
    petForm.reset();
    petFormError.classList.add('hidden');
    razasList.innerHTML = '';
    clienteSearch.value = '';
    clienteIdHidden.value = '';
    selectedClientInfo.classList.add('hidden');
    clienteDropdown.classList.add('hidden');

    if (pet) {
      petIdInput.value = pet.id.toString();
      petClienteIdInput.value = pet.cliente_id.toString();
      clienteIdHidden.value = pet.cliente_id.toString();
      clienteSearch.value = pet.nombre_dueno;
      selectedClientInfo.textContent = `✓ ${pet.nombre_dueno} - ${pet.telefono_dueno}`;
      selectedClientInfo.classList.remove('hidden');
      (petForm.elements.namedItem('nombre') as HTMLInputElement).value = pet.nombre;
      especieInput.value = pet.especie;
      updateBreeds(pet.especie);
      razaInput.value = pet.raza || '';

      // Parse edad (can be "X años", "Y meses", or "X años Y meses")
      const edadStr = pet.edad || '';
      const aniosMatch = edadStr.match(/(\d+)\s*años?/i);
      const mesesMatch = edadStr.match(/(\d+)\s*mes(es)?/i);
      if (aniosMatch) {
        (petForm.elements.namedItem('edad_anios') as HTMLInputElement).value = aniosMatch[1];
      }
      if (mesesMatch) {
        (petForm.elements.namedItem('edad_meses') as HTMLInputElement).value = mesesMatch[1];
      }

      // Parse peso
      const pesoMatch = (pet.peso || '').match(/^([\d.]+)\s*(kg|g)?$/i);
      if (pesoMatch) {
        (petForm.elements.namedItem('peso_valor') as HTMLInputElement).value = pesoMatch[1];
        (petForm.elements.namedItem('peso_unidad') as HTMLSelectElement).value = pesoMatch[2]?.toLowerCase() || 'kg';
      }

      (petForm.elements.namedItem('notas') as HTMLTextAreaElement).value = pet.notas || '';
    } else {
      petIdInput.value = '';
      petClienteIdInput.value = '';
      if (clienteIdFromUrl) {
        const client = clients.find(c => c.id === parseInt(clienteIdFromUrl));
        if (client) {
          clienteIdHidden.value = clienteIdFromUrl;
          clienteSearch.value = client.nombre;
          selectedClientInfo.textContent = `✓ ${client.nombre} - ${client.telefono}`;
          selectedClientInfo.classList.remove('hidden');
        }
      }
    }

    petModal.classList.remove('hidden');
    petModal.classList.add('flex');
  }

  function closePetModalFn() {
    petModal.classList.add('hidden');
    petModal.classList.remove('flex');
  }

  // Global functions
  (window as any).editPet = (id: number) => {
    const pet = pets.find(p => p.id === id);
    if (pet) openPetModal('Editar Mascota', pet);
  };

  (window as any).deletePetPrompt = (id: number) => {
    deletePetId = id;
    deleteModal.classList.remove('hidden');
    deleteModal.classList.add('flex');
  };

  (window as any).openBitacora = async (id: number, name: string) => {
    currentBitacoraMascotaId = id;
    bitacoraMascotaIdInput.value = id.toString();
    bitacoraPetName.textContent = name;
    bitacoraForm.reset();
    bitacoraFormError.classList.add('hidden');
    bitacoraModal.classList.remove('hidden');
    bitacoraModal.classList.add('flex');
    await loadBitacora(id);
  };

  // Bitacora functions
  async function loadBitacora(mascotaId: number) {
    bitacoraLoading.classList.remove('hidden');
    bitacoraEmpty.classList.add('hidden');
    bitacoraList.classList.add('hidden');

    try {
      const entradas = await listarBitacora(mascotaId);
      if (entradas.length === 0) {
        bitacoraEmpty.classList.remove('hidden');
      } else {
        renderBitacora(entradas);
        bitacoraList.classList.remove('hidden');
      }
    } catch (error) {
      console.error('Error loading bitacora:', error);
    } finally {
      bitacoraLoading.classList.add('hidden');
    }
  }

  function renderBitacora(entradas: Bitacora[]) {
    bitacoraList.innerHTML = entradas.map(e => `
      <div class="bg-white rounded-xl p-3 md:p-4" style="border: 1px solid #e2e8f0;">
        <div class="flex justify-between items-start gap-2 mb-2">
          <span class="text-sm font-medium" style="color: #3b82f6;">${formatDateTime(e.fecha)}</span>
          <button onclick="deleteBitacoraEntry(${e.id})" class="text-red-500 hover:text-red-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
        <p class="whitespace-pre-wrap" style="color: #0f172a;">${e.descripcion}</p>
      </div>
    `).join('');
  }

  function formatDateTime(dateStr: string): string {
    const date = new Date(dateStr);
    return date.toLocaleString('es-MX', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  (window as any).deleteBitacoraEntry = async (entradaId: number) => {
    if (!currentBitacoraMascotaId) return;
    if (!confirm('¿Eliminar esta entrada?')) return;
    try {
      await eliminarEntradaBitacora(currentBitacoraMascotaId, entradaId);
      await loadBitacora(currentBitacoraMascotaId);
    } catch (error) {
      console.error('Error deleting bitacora entry:', error);
    }
  };

  // Event listeners
  logoutBtn.addEventListener('click', () => {
    clearSession();
    window.location.href = '/';
  });

  addPetBtn.addEventListener('click', () => openPetModal('Nueva Mascota'));

  closePetModal.addEventListener('click', closePetModalFn);
  cancelPetBtn.addEventListener('click', closePetModalFn);
  petModal.addEventListener('click', (e) => {
    if (e.target === petModal) closePetModalFn();
  });

  searchInput.addEventListener('input', applyFilters);
  searchType.addEventListener('change', applyFilters);
  speciesFilter.addEventListener('change', applyFilters);

  // Pagination (for both top and bottom)
  prevPageBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentPage > 1) { currentPage--; renderTable(); }
    });
  });
  nextPageBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredPets.length / itemsPerPage);
      if (currentPage < totalPages) { currentPage++; renderTable(); }
    });
  });

  // Pet form submit
  petForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    petFormError.classList.add('hidden');

    const formData = new FormData(petForm);
    const clienteIdStr = clienteIdHidden.value;

    if (!clienteIdStr) {
      petFormErrorText.textContent = 'Debes seleccionar un dueño';
      petFormError.classList.remove('hidden');
      return;
    }

    const clienteId = parseInt(clienteIdStr);
    const edadAnios = formData.get('edad_anios') as string;
    const edadMeses = formData.get('edad_meses') as string;
    const pesoValor = formData.get('peso_valor') as string;
    const pesoUnidad = formData.get('peso_unidad') as string;

    // Build age string
    let edadStr = '';
    if (edadAnios && parseInt(edadAnios) > 0) {
      edadStr = `${edadAnios} año${parseInt(edadAnios) > 1 ? 's' : ''}`;
    }
    if (edadMeses && parseInt(edadMeses) > 0) {
      if (edadStr) edadStr += ' ';
      edadStr += `${edadMeses} mes${parseInt(edadMeses) > 1 ? 'es' : ''}`;
    }

    const data: MascotaCreate = {
      nombre: formData.get('nombre') as string,
      especie: formData.get('especie') as string,
      raza: formData.get('raza') as string || undefined,
      edad: edadStr || undefined,
      peso: pesoValor ? `${pesoValor} ${pesoUnidad}` : undefined,
      notas: formData.get('notas') as string || undefined,
    };

    try {
      const id = petIdInput.value;
      if (id) {
        await actualizarMascota(parseInt(id), data);
      } else {
        await crearMascota(clienteId, data);
      }
      // Persist custom species/breed if new
      persistCustomSpecies(data.especie);
      if (data.raza) persistCustomBreed(data.especie, data.raza);
      closePetModalFn();
      loadData();
    } catch (error) {
      petFormErrorText.textContent = error instanceof Error ? error.message : 'Error al guardar';
      petFormError.classList.remove('hidden');
    }
  });

  // Delete modal
  cancelDelete.addEventListener('click', () => {
    deleteModal.classList.add('hidden');
    deleteModal.classList.remove('flex');
    deletePetId = null;
  });

  confirmDelete.addEventListener('click', async () => {
    if (!deletePetId) return;
    try {
      await eliminarMascota(deletePetId);
      deleteModal.classList.add('hidden');
      deleteModal.classList.remove('flex');
      deletePetId = null;
      loadData();
    } catch (error) {
      console.error('Error deleting pet:', error);
    }
  });

  // Bitacora modal
  closeBitacora.addEventListener('click', () => {
    bitacoraModal.classList.add('hidden');
    bitacoraModal.classList.remove('flex');
    currentBitacoraMascotaId = null;
  });

  bitacoraForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    bitacoraFormError.classList.add('hidden');
    if (!currentBitacoraMascotaId) return;

    const formData = new FormData(bitacoraForm);
    const data: BitacoraCreate = {
      tipo: 'Avance',
      descripcion: formData.get('descripcion') as string,
    };

    try {
      await crearEntradaBitacora(currentBitacoraMascotaId, data);
      bitacoraForm.reset();
      await loadBitacora(currentBitacoraMascotaId);
    } catch (error) {
      bitacoraFormErrorText.textContent = error instanceof Error ? error.message : 'Error al guardar';
      bitacoraFormError.classList.remove('hidden');
    }
  });

  // Pet context menu elements
  const petContextMenu = document.getElementById('petContextMenu') as HTMLDivElement;
  const ctxEditPet = document.getElementById('ctxEditPet') as HTMLButtonElement;
  const ctxBitacora = document.getElementById('ctxBitacora') as HTMLButtonElement;
  const ctxDeletePet = document.getElementById('ctxDeletePet') as HTMLButtonElement;
  let contextPetName: string = '';

  // Context menu with proper positioning
  (window as any).showPetContextMenu = (e: MouseEvent, petId: number, petName: string) => {
    e.preventDefault();
    contextPetId = petId;
    contextPetName = petName;

    const menuWidth = 180;
    const menuHeight = 140;
    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;

    let x = e.clientX;
    let y = e.clientY;

    if (x + menuWidth > viewportWidth) x = viewportWidth - menuWidth - 10;
    if (y + menuHeight > viewportHeight) y = viewportHeight - menuHeight - 10;
    if (x < 10) x = 10;
    if (y < 10) y = 10;

    petContextMenu.style.left = `${x}px`;
    petContextMenu.style.top = `${y}px`;
    petContextMenu.classList.remove('hidden');
  };

  document.addEventListener('click', () => {
    petContextMenu.classList.add('hidden');
  });

  document.addEventListener('scroll', () => {
    petContextMenu.classList.add('hidden');
  }, true);

  ctxEditPet.addEventListener('click', () => {
    if (contextPetId) {
      (window as any).editPet(contextPetId);
    }
    petContextMenu.classList.add('hidden');
  });

  ctxBitacora.addEventListener('click', () => {
    if (contextPetId && contextPetName) {
      (window as any).openBitacora(contextPetId, contextPetName);
    }
    petContextMenu.classList.add('hidden');
  });

  ctxDeletePet.addEventListener('click', () => {
    if (contextPetId) {
      deletePetId = contextPetId;
      deleteModal.classList.remove('hidden');
      deleteModal.classList.add('flex');
    }
    petContextMenu.classList.add('hidden');
  });

  // Initial load
  loadData();
</script>
