---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Clientes - Sistema Veterinarias">
  <div class="min-h-screen flex">
    <Sidebar />

    <!-- Main ContentWrapper -->
    <div class="flex-1 flex flex-col min-h-screen lg:ml-64 transition-all duration-300" data-main-content>
      <!-- Top Navbar -->
      <header class="bg-white sticky top-0 z-30" style="border-bottom: 1px solid #e2e8f0;">
        <div class="px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center">
          <div class="flex items-center space-x-3">
            <!-- Mobile hamburger button -->
            <button id="hamburgerBtn" class="lg:hidden p-2 rounded-lg transition-colors" style="color: #475569;">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
            <a href="/home" class="p-2 rounded-lg transition-colors" style="color: #9a8b7c;">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </a>
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <span class="font-bold text-base sm:text-lg" style="color: #0f172a;" id="vetName">Cargando...</span>
          </div>
          <div class="flex items-center space-x-2">
            <a href="/mascotas" class="p-2 sm:px-3 sm:py-1.5 rounded-lg text-sm transition-colors flex items-center space-x-1" style="color: #475569;">
              <svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
              <span class="hidden sm:inline">Mascotas</span>
            </a>
            <!-- TODO: Activar en Avance 2 / Avance 3 (Estadísticas)
            <a href="/estadisticas" class="p-2 sm:px-3 sm:py-1.5 rounded-lg text-sm transition-colors flex items-center space-x-1" style="color: #475569;">
              <svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <span class="hidden sm:inline">Estadísticas</span>
            </a>
            -->
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8 flex-1 w-full">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
          <h1 class="text-xl md:text-2xl font-bold" style="color: #0f172a;">Clientes (Dueños)</h1>
          <p class="text-sm md:text-base" style="color: #475569;">Gestiona los dueños de mascotas</p>
        </div>
        <button
          id="addClientBtn"
          class="w-full sm:w-auto px-4 py-2.5 text-white font-semibold rounded-xl transition-all flex items-center justify-center space-x-2"
          style="background: linear-gradient(135deg, #3b82f6, #2563eb);"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <span>Nuevo Cliente</span>
        </button>
      </div>

      <!-- Stats Card -->
      <div class="bg-white rounded-xl p-4 mb-6" style="border: 1px solid #e2e8f0;">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(13,148,136,0.10);">
            <svg class="w-5 h-5" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold" style="color: #0f172a;" id="totalClients">0</p>
            <p class="text-xs" style="color: #9a8b7c;">Total Clientes</p>
          </div>
        </div>
      </div>

      <!-- Search Filter -->
      <div class="bg-white rounded-xl p-4 mb-6" style="border: 1px solid #e2e8f0;">
        <div class="flex flex-col sm:flex-row gap-3">
          <!-- Search Type Selector -->
          <div class="sm:w-44">
            <select
              id="searchType"
              class="w-full px-3 py-2.5 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
              style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
            >
              <option value="todo">Buscar en todo</option>
              <option value="id">Por ID (exacto)</option>
              <option value="nombre">Por nombre</option>
              <option value="telefono">Por teléfono</option>
            </select>
          </div>
          <!-- Search Input -->
          <div class="relative flex-1">
            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5" style="color: #9a8b7c;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
              type="text"
              id="searchInput"
              placeholder="Escribe para buscar..."
              class="w-full pl-10 pr-4 py-2.5 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
              style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
            />
          </div>
        </div>
      </div>

      <!-- Clients List -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-sm" style="border: 1px solid #e2e8f0;">
        <div id="loadingState" class="p-12 text-center">
          <div class="animate-spin w-8 h-8 border-2 border-blue-500 border-t-transparent rounded-full mx-auto mb-4"></div>
          <p style="color: #9a8b7c;">Cargando clientes...</p>
        </div>

        <div id="emptyState" class="hidden p-12 text-center">
          <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4" style="background: rgba(13,148,136,0.08);">
            <svg class="w-8 h-8" style="color: #9a8b7c;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-medium mb-2" style="color: #0f172a;">No hay clientes registrados</h3>
          <p class="mb-4" style="color: #9a8b7c;">Comienza agregando tu primer cliente</p>
        </div>

        <!-- Top Pagination -->
        <div id="paginationTop" class="hidden px-4 py-3 flex flex-col sm:flex-row items-center justify-between gap-2" style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
          <div class="text-xs sm:text-sm" style="color: #475569;">
            Mostrando <span class="showingFromSync font-medium" style="color: #0f172a;">1</span> - <span class="showingToSync font-medium" style="color: #0f172a;">500</span> de <span class="totalItemsSync font-medium" style="color: #0f172a;">0</span>
          </div>
          <div class="flex items-center space-x-2">
            <button class="prevPageSync px-3 py-1.5 rounded-lg text-xs sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed transition-colors" style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;">
              ← Anterior
            </button>
            <span class="px-2 py-1 text-xs sm:text-sm" style="color: #475569;">
              Pág <span class="currentPageSync font-medium" style="color: #0f172a;">1</span>/<span class="totalPagesSync font-medium" style="color: #0f172a;">1</span>
            </span>
            <button class="nextPageSync px-3 py-1.5 rounded-lg text-xs sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed transition-colors" style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;">
              Siguiente →
            </button>
          </div>
        </div>

        <div id="tableContainer" class="hidden">
          <table class="w-full">
            <thead style="background: #f8fafc;">
              <tr>
                <th class="px-3 py-2.5 text-left text-xs font-medium uppercase hidden md:table-cell w-12" style="color: #9a8b7c;">ID</th>
                <th class="px-3 py-2.5 text-left text-xs font-medium uppercase" style="color: #9a8b7c;">Cliente</th>
                <th class="px-3 py-2.5 text-left text-xs font-medium uppercase hidden md:table-cell" style="color: #9a8b7c;">Teléfono</th>
                <th class="px-3 py-2.5 text-left text-xs font-medium uppercase hidden xl:table-cell" style="color: #9a8b7c;">Dirección</th>
                <th class="px-3 py-2.5 text-center text-xs font-medium uppercase w-20" style="color: #9a8b7c;">Mascotas</th>
                <th class="px-3 py-2.5 text-left text-xs font-medium uppercase hidden md:table-cell w-24" style="color: #9a8b7c;">Registro</th>
                <th class="px-3 py-2.5 text-right text-xs font-medium uppercase w-28" style="color: #9a8b7c;">Acciones</th>
              </tr>
            </thead>
            <tbody id="clientsTableBody" style="border-top: 1px solid #e2e8f0;">
            </tbody>
          </table>
        </div>

        <!-- Bottom Pagination -->
        <div id="paginationContainer" class="hidden px-4 py-3 flex flex-col sm:flex-row items-center justify-between gap-2" style="border-top: 1px solid #e2e8f0; background: #f8fafc;">
          <div class="text-xs sm:text-sm" style="color: #475569;">
            Mostrando <span class="showingFromSync font-medium" style="color: #0f172a;">1</span> - <span class="showingToSync font-medium" style="color: #0f172a;">500</span> de <span class="totalItemsSync font-medium" style="color: #0f172a;">0</span>
          </div>
          <div class="flex items-center space-x-2">
            <button class="prevPageSync px-3 py-1.5 rounded-lg text-xs sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed transition-colors" style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;">
              ← Anterior
            </button>
            <span class="px-2 py-1 text-xs sm:text-sm" style="color: #475569;">
              Pág <span class="currentPageSync font-medium" style="color: #0f172a;">1</span>/<span class="totalPagesSync font-medium" style="color: #0f172a;">1</span>
            </span>
            <button class="nextPageSync px-3 py-1.5 rounded-lg text-xs sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed transition-colors" style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;">
              Siguiente →
            </button>
          </div>
        </div>
      </div>
    </main>
    </div><!-- /Main ContentWrapper -->
  </div><!-- /Root flex -->

  <!-- Modal Crear/Editar Cliente -->
  <div id="modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl w-full max-w-md max-h-[90vh] overflow-y-auto shadow-xl" style="border: 1px solid #e2e8f0;">
      <div class="p-4 md:p-6 flex justify-between items-center sticky top-0 bg-white" style="border-bottom: 1px solid #e2e8f0;">
        <h3 id="modalTitle" class="text-lg md:text-xl font-bold" style="color: #0f172a;">Nuevo Cliente</h3>
        <button id="closeModal" class="p-1" style="color: #9a8b7c;">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <form id="clientForm" class="p-4 md:p-6 space-y-4">
        <input type="hidden" id="clientId" />

        <div>
          <label class="block text-sm font-medium mb-1" style="color: #475569;">Nombre completo *</label>
          <input
            type="text"
            name="nombre"
            required
            maxlength="100"
            class="w-full px-3 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
            placeholder="Juan Pérez"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-1" style="color: #475569;">Teléfono (10 dígitos) *</label>
          <input
            type="tel"
            name="telefono"
            id="clientPhone"
            required
            maxlength="10"
            inputmode="numeric"
            class="w-full px-3 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
            placeholder="5551234567"
            oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10)"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-1" style="color: #475569;">Email *</label>
          <input
            type="text"
            name="email"
            id="clientEmail"
            required
            maxlength="100"
            class="w-full px-3 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
            placeholder="cliente@email.com"
          />
        </div>

        <!-- Dirección desglosada en 4 campos obligatorios -->
        <div class="space-y-3 pt-1">
          <p class="text-sm font-semibold" style="color: #475569;">Dirección *</p>
          <div class="grid grid-cols-3 gap-2">
            <div class="col-span-2">
              <label class="block text-xs font-medium mb-1" style="color: #64748b;">Calle *</label>
              <input
                type="text"
                name="calle"
                id="clientCalle"
                required
                maxlength="100"
                class="w-full px-3 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
                placeholder="Av. Insurgentes Sur"
              />
            </div>
            <div>
              <label class="block text-xs font-medium mb-1" style="color: #64748b;">Núm. dom. *</label>
              <input
                type="text"
                name="numero_domicilio"
                id="clientNumero"
                required
                maxlength="20"
                class="w-full px-3 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
                placeholder="123"
              />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-medium mb-1" style="color: #64748b;">Colonia *</label>
              <input
                type="text"
                name="colonia"
                id="clientColonia"
                required
                maxlength="80"
                class="w-full px-3 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
                placeholder="Del Valle"
              />
            </div>
            <div>
              <label class="block text-xs font-medium mb-1" style="color: #64748b;">Municipio / Alcaldía *</label>
              <input
                type="text"
                name="municipio"
                id="clientMunicipio"
                required
                maxlength="80"
                class="w-full px-3 py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a;"
                placeholder="Benito Juárez"
              />
            </div>
          </div>
        </div>

        <div id="formError" class="hidden p-3 bg-red-500/20 border border-red-500/30 rounded-lg">
          <p class="text-red-500 text-sm" id="formErrorText"></p>
        </div>

        <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 sm:space-x-3 pt-4" style="border-top: 1px solid #e2e8f0;">
          <button
            type="button"
            id="cancelBtn"
            class="w-full sm:w-auto px-4 py-2.5 rounded-lg transition-colors"
            style="background: #f1f5f9; color: #475569;"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="saveBtn"
            class="w-full sm:w-auto px-6 py-2.5 text-white font-semibold rounded-lg transition-all"
            style="background: linear-gradient(135deg, #3b82f6, #2563eb);"
          >
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Confirmar Eliminación -->
  <div id="deleteModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-xl" style="border: 1px solid #e2e8f0;">
      <div class="text-center">
        <div class="w-12 h-12 rounded-full bg-red-500/20 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold mb-2" style="color: #0f172a;">¿Eliminar cliente?</h3>
        <p class="mb-6 text-sm" style="color: #475569;">Se eliminarán también todas sus mascotas y bitácoras. Esta acción no se puede deshacer.</p>
        <div class="flex flex-col-reverse sm:flex-row justify-center gap-2 sm:space-x-3">
          <button
            id="cancelDelete"
            class="w-full sm:w-auto px-4 py-2.5 rounded-lg transition-colors"
            style="background: #f1f5f9; color: #475569;"
          >
            Cancelar
          </button>
          <button
            id="confirmDelete"
            class="w-full sm:w-auto px-6 py-2.5 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition-colors"
          >
            Eliminar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Context Menu -->
  <div id="contextMenu" class="fixed hidden bg-white rounded-xl shadow-2xl py-2 z-50 min-w-[160px]" style="border: 1px solid #e2e8f0;">
    <button id="ctxEdit" class="w-full px-4 py-2.5 text-left text-sm flex items-center space-x-3 transition-colors hover:bg-black/5" style="color: #0f172a;">
      <svg class="w-4 h-4" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
      </svg>
      <span>Editar</span>
    </button>
    <button id="ctxMascotas" class="w-full px-4 py-2.5 text-left text-sm flex items-center space-x-3 transition-colors hover:bg-black/5" style="color: #0f172a;">
      <svg class="w-4 h-4" style="color: #3b82f6;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
      </svg>
      <span>Ver Mascotas</span>
    </button>
    <div class="my-1" style="border-top: 1px solid #e2e8f0;"></div>
    <button id="ctxDelete" class="w-full px-4 py-2.5 text-left text-sm text-red-500 hover:bg-red-500/10 flex items-center space-x-3 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
      <span>Eliminar</span>
    </button>
  </div>
</Layout>

<style>
  :global(body) {
    background: #f1f5f9 !important;
  }
</style>

<script>
  import type { Cliente } from '../domain/models/cliente';
  import { getVeterinaria, getUsuario, clearSession, isAuthenticated } from '../infrastructure/api/authService';
  import { listarClientes, eliminarCliente } from '../infrastructure/api/clienteService';
  import {
    filterClientes,
    formatClientDate,
    guardarClienteUseCase,
    parseClientDireccion,
  } from '../application/use_cases/clienteUseCases';

  // Check auth
  if (!isAuthenticated()) {
    window.location.href = '/';
  }
  const _meClientes = getUsuario();
  if (_meClientes?.rol === 'veterinario') { window.location.href = '/home'; }

  // Sidebar elements
  const sidebar = document.getElementById('sidebar') as HTMLElement | null;
  const sidebarOverlay = document.getElementById('sidebarOverlay') as HTMLDivElement | null;
  const hamburgerBtn = document.getElementById('hamburgerBtn') as HTMLButtonElement | null;
  const vetNameEl = document.getElementById('vetName') as HTMLSpanElement | null;
  const sidebarVetName = document.getElementById('sidebarVetName') as HTMLParagraphElement | null;
  const userAvatar = document.getElementById('userAvatar') as HTMLDivElement | null;
  const logoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement | null;

  // Elements
  const addClientBtn = document.getElementById('addClientBtn') as HTMLButtonElement | null;
  const loadingState = document.getElementById('loadingState') as HTMLDivElement | null;
  const emptyState = document.getElementById('emptyState') as HTMLDivElement | null;
  const tableContainer = document.getElementById('tableContainer') as HTMLDivElement | null;
  const clientsTableBody = document.getElementById('clientsTableBody') as HTMLTableSectionElement | null;
  const totalClientsEl = document.getElementById('totalClients') as HTMLParagraphElement | null;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const searchType = document.getElementById('searchType') as HTMLSelectElement | null;

  // Pagination elements
  const paginationContainer = document.getElementById('paginationContainer') as HTMLDivElement | null;
  const paginationTop = document.getElementById('paginationTop') as HTMLDivElement | null;
  const prevPageBtns = document.querySelectorAll('.prevPageSync') as NodeListOf<HTMLButtonElement>;
  const nextPageBtns = document.querySelectorAll('.nextPageSync') as NodeListOf<HTMLButtonElement>;
  const currentPageDisplays = document.querySelectorAll('.currentPageSync') as NodeListOf<HTMLSpanElement>;
  const totalPagesDisplays = document.querySelectorAll('.totalPagesSync') as NodeListOf<HTMLSpanElement>;
  const showingFromEls = document.querySelectorAll('.showingFromSync') as NodeListOf<HTMLSpanElement>;
  const showingToEls = document.querySelectorAll('.showingToSync') as NodeListOf<HTMLSpanElement>;
  const totalItemsEls = document.querySelectorAll('.totalItemsSync') as NodeListOf<HTMLSpanElement>;

  // Modal elements
  const modal = document.getElementById('modal') as HTMLDivElement | null;
  const modalTitle = document.getElementById('modalTitle') as HTMLHeadingElement | null;
  const closeModal = document.getElementById('closeModal') as HTMLButtonElement | null;
  const cancelBtn = document.getElementById('cancelBtn') as HTMLButtonElement | null;
  const clientForm = document.getElementById('clientForm') as HTMLFormElement | null;
  const clientIdInput = document.getElementById('clientId') as HTMLInputElement | null;
  const formError = document.getElementById('formError') as HTMLDivElement | null;
  const formErrorText = document.getElementById('formErrorText') as HTMLParagraphElement | null;

  // Delete modal
  const deleteModal = document.getElementById('deleteModal') as HTMLDivElement | null;
  const cancelDelete = document.getElementById('cancelDelete') as HTMLButtonElement | null;
  const confirmDelete = document.getElementById('confirmDelete') as HTMLButtonElement | null;

  // Context menu
  const contextMenu = document.getElementById('contextMenu') as HTMLDivElement | null;
  const ctxEdit = document.getElementById('ctxEdit') as HTMLButtonElement | null;
  const ctxMascotas = document.getElementById('ctxMascotas') as HTMLButtonElement | null;
  const ctxDelete = document.getElementById('ctxDelete') as HTMLButtonElement | null;

  // State
  let clients: Cliente[] = [];
  let filteredClients: Cliente[] = [];
  let currentPage = 1;
  const itemsPerPage = 500;
  let deleteClientId: number | null = null;
  let contextClientId: number | null = null;

  // Load vet name (safely ignore if elements are missing/commented out)
  const vet = getVeterinaria();
  if (vet) {
    if (vetNameEl) vetNameEl.textContent = vet.nombre;
    if (sidebarVetName) sidebarVetName.textContent = vet.nombre;
    if (userAvatar) userAvatar.textContent = vet.nombre.charAt(0).toUpperCase();
  }

  // Mobile sidebar toggle
  hamburgerBtn?.addEventListener('click', () => {
    sidebar?.classList.toggle('-translate-x-full');
    sidebarOverlay?.classList.toggle('hidden');
  });

  sidebarOverlay?.addEventListener('click', () => {
    sidebar?.classList.add('-translate-x-full');
    sidebarOverlay?.classList.add('hidden');
  });

  // Load clients
  async function loadClients() {
    try {
      clients = await listarClientes();
      filteredClients = [...clients];
      updateStats();
      renderTable();
    } catch (error) {
      console.error('Error loading clients:', error);
    } finally {
      loadingState?.classList.add('hidden');
    }
  }

  // Update stats
  function updateStats() {
    if (totalClientsEl) totalClientsEl.textContent = clients.length.toString();
  }

  // Apply filters
  function applyFilters() {
    filteredClients = filterClientes(
      clients,
      searchInput?.value || '',
      searchType?.value || 'todo'
    );
    currentPage = 1;
    renderTable();
  }

  // Render table
  function renderTable() {
    if (filteredClients.length === 0) {
      tableContainer?.classList.add('hidden');
      emptyState?.classList.remove('hidden');
      paginationContainer?.classList.add('hidden');
      paginationTop?.classList.add('hidden');
      return;
    }

    emptyState?.classList.add('hidden');
    tableContainer?.classList.remove('hidden');

    // Calculate pagination
    const totalPages = Math.ceil(filteredClients.length / itemsPerPage);
    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = Math.min(startIndex + itemsPerPage, filteredClients.length);
    const paginatedClients = filteredClients.slice(startIndex, endIndex);

    // Update pagination info (both top and bottom)
    if (filteredClients.length > itemsPerPage) {
      paginationContainer?.classList.remove('hidden');
      paginationContainer?.classList.add('flex');
      paginationTop?.classList.remove('hidden');
      paginationTop?.classList.add('flex');

      showingFromEls.forEach(el => el.textContent = (startIndex + 1).toString());
      showingToEls.forEach(el => el.textContent = endIndex.toString());
      totalItemsEls.forEach(el => el.textContent = filteredClients.length.toString());
      currentPageDisplays.forEach(el => el.textContent = currentPage.toString());
      totalPagesDisplays.forEach(el => el.textContent = totalPages.toString());
      prevPageBtns.forEach(btn => btn.disabled = currentPage === 1);
      nextPageBtns.forEach(btn => btn.disabled = currentPage === totalPages);
    } else {
      paginationContainer?.classList.add('hidden');
      paginationTop?.classList.add('hidden');
    }

    if (!clientsTableBody) return;

    // Render rows
    clientsTableBody.innerHTML = paginatedClients.map(client => `
      <tr style="cursor:pointer;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background=''" data-client-id="${client.id}" oncontextmenu="event.preventDefault(); showContextMenu(event, ${client.id})">
        <td class="px-3 py-3 text-sm hidden md:table-cell" style="color: #9a8b7c;">#${client.id}</td>
        <td class="px-3 py-3">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(13,148,136,0.10);">
              <span class="text-sm font-semibold" style="color: #3b82f6;">${client.nombre.charAt(0).toUpperCase()}</span>
            </div>
            <div class="min-w-0">
              <p class="font-medium text-sm truncate" style="color: #0f172a;">${client.nombre}</p>
              <p class="text-xs md:hidden" style="color: #9a8b7c;">${client.telefono}</p>
              <p class="text-xs truncate" style="color: #94a3b8;">${client.email || '-'}</p>
            </div>
          </div>
        </td>
        <td class="px-3 py-3 text-sm hidden md:table-cell" style="color: #475569;">${client.telefono}</td>
        <td class="px-3 py-3 text-xs hidden xl:table-cell truncate max-w-[180px]" style="color: #9a8b7c;">${client.direccion || '-'}</td>
        <td class="px-3 py-3 text-center">
          <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-xs font-medium" style="${client.total_mascotas > 0 ? 'background: rgba(13,148,136,0.08); color: #3b82f6;' : 'background: #f1f5f9; color: #94a3b8;'}">${client.total_mascotas || 0}</span>
        </td>
        <td class="px-3 py-3 text-xs hidden md:table-cell" style="color: #9a8b7c;">${formatClientDate(client.fecha_creacion)}</td>
        <td class="px-3 py-3">
          <div class="flex justify-end space-x-1">
            <button onclick="event.stopPropagation(); goToMascotas(${client.id})" class="p-2 rounded-lg transition-colors hover:bg-black/5" style="color: #3b82f6;" title="Ver Mascotas">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </button>
            <button onclick="event.stopPropagation(); editClient(${client.id})" class="p-2 rounded-lg transition-colors hover:bg-black/5" style="color: #3b82f6;" title="Editar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </button>
            <button onclick="event.stopPropagation(); deleteClientPrompt(${client.id})" class="p-2 rounded-lg transition-colors hover:bg-black/5" style="color: #ef4444;" title="Eliminar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  // Modal functions
  function openModal(title: string, client?: Cliente) {
    if (!modal || !clientForm) return;
    if (modalTitle) modalTitle.textContent = title;
    clientForm.reset();
    formError?.classList.add('hidden');

    if (client) {
      if (clientIdInput) clientIdInput.value = client.id.toString();
      const nombreInput = clientForm.elements.namedItem('nombre') as HTMLInputElement | null;
      const telInput = clientForm.elements.namedItem('telefono') as HTMLInputElement | null;
      const emailInput = clientForm.elements.namedItem('email') as HTMLInputElement | null;
      if (nombreInput) nombreInput.value = client.nombre;
      if (telInput) telInput.value = client.telefono;
      if (emailInput) emailInput.value = client.email || '';

      const parsed = parseClientDireccion(client.direccion);
      const calleInput = clientForm.elements.namedItem('calle') as HTMLInputElement | null;
      const numInput = clientForm.elements.namedItem('numero_domicilio') as HTMLInputElement | null;
      const colInput = clientForm.elements.namedItem('colonia') as HTMLInputElement | null;
      const munInput = clientForm.elements.namedItem('municipio') as HTMLInputElement | null;
      if (calleInput) calleInput.value = parsed.calle;
      if (numInput) numInput.value = parsed.numero;
      if (colInput) colInput.value = parsed.colonia;
      if (munInput) munInput.value = parsed.municipio;
    } else {
      if (clientIdInput) clientIdInput.value = '';
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModalFn() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  // Context menu with proper positioning
  (window as any).showContextMenu = (e: MouseEvent, clientId: number) => {
    e.preventDefault();
    contextClientId = clientId;
    if (!contextMenu) return;

    const menuWidth = 180;
    const menuHeight = 140;
    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;

    let x = e.clientX;
    let y = e.clientY;

    if (x + menuWidth > viewportWidth) x = viewportWidth - menuWidth - 10;
    if (y + menuHeight > viewportHeight) y = viewportHeight - menuHeight - 10;
    if (x < 10) x = 10;
    if (y < 10) y = 10;

    contextMenu.style.left = `${x}px`;
    contextMenu.style.top = `${y}px`;
    contextMenu.classList.remove('hidden');
  };

  document.addEventListener('click', () => {
    contextMenu?.classList.add('hidden');
  });

  document.addEventListener('scroll', () => {
    contextMenu?.classList.add('hidden');
  }, true);

  ctxEdit?.addEventListener('click', () => {
    if (contextClientId) {
      const client = clients.find(c => c.id === contextClientId);
      if (client) openModal('Editar Cliente', client);
    }
  });

  ctxMascotas?.addEventListener('click', () => {
    if (contextClientId) {
      window.location.href = `/mascotas?cliente=${contextClientId}`;
    }
  });

  ctxDelete?.addEventListener('click', () => {
    if (contextClientId) {
      deleteClientId = contextClientId;
      deleteModal?.classList.remove('hidden');
      deleteModal?.classList.add('flex');
    }
  });

  // Global functions
  (window as any).editClient = (id: number) => {
    const client = clients.find(c => c.id === id);
    if (client) openModal('Editar Cliente', client);
  };

  (window as any).goToMascotas = (id: number) => {
    window.location.href = `/mascotas?cliente=${id}`;
  };

  (window as any).deleteClientPrompt = (id: number) => {
    deleteClientId = id;
    deleteModal?.classList.remove('hidden');
    deleteModal?.classList.add('flex');
  };

  // Event listeners
  logoutBtn?.addEventListener('click', () => {
    clearSession();
    window.location.href = '/';
  });

  addClientBtn?.addEventListener('click', () => openModal('Nuevo Cliente'));

  closeModal?.addEventListener('click', closeModalFn);
  cancelBtn?.addEventListener('click', closeModalFn);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModalFn();
  });

  searchInput?.addEventListener('input', applyFilters);
  searchType?.addEventListener('change', applyFilters);

  // Pagination (for both top and bottom)
  prevPageBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderTable();
      }
    });
  });

  nextPageBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredClients.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        renderTable();
      }
    });
  });

  // Form submit
  clientForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError?.classList.add('hidden');

    const formData = new FormData(clientForm);

    try {
      await guardarClienteUseCase(clientIdInput?.value || null, {
        nombre: (formData.get('nombre') as string) || '',
        telefono: (formData.get('telefono') as string) || '',
        email: (formData.get('email') as string) || undefined,
        calle: (formData.get('calle') as string) || '',
        numero_domicilio: (formData.get('numero_domicilio') as string) || '',
        colonia: (formData.get('colonia') as string) || '',
        municipio: (formData.get('municipio') as string) || '',
      });
      closeModalFn();
      loadClients();
    } catch (error) {
      if (formErrorText) formErrorText.textContent = error instanceof Error ? error.message : 'Error al guardar';
      formError?.classList.remove('hidden');
    }
  });

  // Delete modal
  cancelDelete?.addEventListener('click', () => {
    deleteModal?.classList.add('hidden');
    deleteModal?.classList.remove('flex');
    deleteClientId = null;
  });

  confirmDelete?.addEventListener('click', async () => {
    if (!deleteClientId) return;
    try {
      await eliminarCliente(deleteClientId);
      deleteModal?.classList.add('hidden');
      deleteModal?.classList.remove('flex');
      deleteClientId = null;
      loadClients();
    } catch (error) {
      console.error('Error deleting client:', error);
    }
  });

  // Initial load
  loadClients();
</script>
